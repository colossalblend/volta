<?xml version="1.0" encoding="utf-8"?>
<!-- Only in the APKs published on GitHub Releases, never in the Google Play build. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- In-app updates: hands a downloaded APK to Android's installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Split tunnelling: system apps without a launcher icon can be picked too. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
</manifest>
