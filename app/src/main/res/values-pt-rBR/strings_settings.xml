    <!-- Settings screen -->
    <string name="settings_title">Configurações</string>
    <string name="settings_simple_title">Modo simples</string>
    <string name="settings_simple_text">Um único botão grande “Ligar / Desligar”, e o servidor é escolhido sozinho. Prático para os pais e para quem não precisa de configurações.</string>
    <string name="settings_section_connection">Conexão</string>
    <string name="settings_follow_network_title">Acompanhar a troca de rede</string>
    <string name="settings_follow_network_text">Ao alternar entre Wi-Fi e dados móveis, o servidor é verificado e trocado sozinho.</string>
    <string name="settings_recheck_title">Melhorar a escolha do servidor</string>
    <string name="settings_recheck_text">A cada 15 minutos, com a tela ligada, compara os servidores e muda para um visivelmente mais rápido. Um servidor que não responde é sempre trocado.</string>
    <string name="settings_failover_title">Trocar de servidor se cair</string>
    <string name="settings_failover_text">Se o servidor parar de responder, o Volta muda para outro.</string>
    <string name="settings_autoconnect_title">Conectar ao iniciar</string>
    <string name="settings_autoconnect_text">Ligar a VPN logo depois que o sistema iniciar.</string>

    <!-- Android's own kill switch. The quoted names are Android's own settings (Always-on VPN,
         Block connections without VPN), as Android calls them in that language. -->
    <string name="settings_killswitch_title">Bloquear a internet sem VPN</string>
    <string name="settings_killswitch_unknown">O Android pode manter o Volta sempre ligado e bloquear a internet enquanto a VPN não estiver conectada. Toque aqui e depois na engrenagem ao lado do Volta: “VPN sempre ativa” e “Bloquear conexões sem VPN”.</string>
    <string name="settings_killswitch_on">Ativado: o Volta fica sempre ligado e, sem VPN, a internet fica bloqueada. Desligue a VPN e a internet some — é de propósito.</string>
    <string name="settings_killswitch_partial">O Volta liga sozinho, mas enquanto a VPN conecta, os apps acessam a internet diretamente. Ative “Bloquear conexões sem VPN” na engrenagem ao lado do Volta.</string>
    <string name="settings_killswitch_off">Desativado. Toque aqui e depois na engrenagem ao lado do Volta: “VPN sempre ativa” e “Bloquear conexões sem VPN”.</string>
    <string name="settings_no_vpn_settings">Este dispositivo não tem configurações de VPN</string>

