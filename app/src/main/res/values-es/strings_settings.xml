    <!-- Settings screen -->
    <string name="settings_title">Ajustes</string>
    <string name="settings_simple_title">Modo sencillo</string>
    <string name="settings_simple_text">Un solo botón grande «Activar / Desactivar», y el servidor se elige solo. Práctico para los padres y para quien no necesite ajustes.</string>
    <string name="settings_section_connection">Conexión</string>
    <string name="settings_follow_network_title">Seguir los cambios de red</string>
    <string name="settings_follow_network_text">Al pasar de Wi-Fi a datos móviles o al revés, el servidor se comprueba y se cambia solo.</string>
    <string name="settings_recheck_title">Mejorar la elección de servidor</string>
    <string name="settings_recheck_text">Cada 15 minutos, con la pantalla encendida, compara los servidores y pasa a uno notablemente más rápido. Un servidor que no responde siempre se cambia.</string>
    <string name="settings_failover_title">Cambiar de servidor si se corta</string>
    <string name="settings_failover_text">Si el servidor deja de responder, Volta pasará a otro.</string>
    <string name="settings_autoconnect_title">Conectar al iniciar</string>
    <string name="settings_autoconnect_text">Activar la VPN justo al encender el dispositivo.</string>

    <!-- Android's own kill switch. The quoted names are Android's own settings (Always-on VPN,
         Block connections without VPN), as Android calls them in that language. -->
    <string name="settings_killswitch_title">Bloquear internet sin VPN</string>
    <string name="settings_killswitch_unknown">Android puede mantener Volta siempre activa y cortar internet mientras la VPN no esté conectada. Toca aquí y luego el engranaje junto a Volta: «VPN siempre activada» y «Bloquear conexiones sin VPN».</string>
    <string name="settings_killswitch_on">Activado: Volta está siempre activa y sin VPN no hay internet. Si desactivas la VPN, se corta internet; está hecho así a propósito.</string>
    <string name="settings_killswitch_partial">Volta se activa sola, pero mientras la VPN se conecta, las apps salen a internet directamente. Activa «Bloquear conexiones sin VPN» en el engranaje junto a Volta.</string>
    <string name="settings_killswitch_off">Desactivado. Toca aquí y luego el engranaje junto a Volta: «VPN siempre activada» y «Bloquear conexiones sin VPN».</string>
    <string name="settings_no_vpn_settings">Este dispositivo no tiene ajustes de VPN</string>

