<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="volta_toggle"
        android:enabled="true"
        android:icon="@drawable/ic_swap"
        android:shortcutShortLabel="@string/action_toggle"
        android:shortcutLongLabel="@string/action_toggle">
        <intent
            android:action="com.ars3nb.volta.TOGGLE"
            android:targetPackage="com.ars3nb.volta"
            android:targetClass="com.ars3nb.volta.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="volta_disconnect"
        android:enabled="true"
        android:icon="@drawable/ic_vpn_off"
        android:shortcutShortLabel="@string/action_disconnect"
        android:shortcutLongLabel="@string/action_disconnect">
        <intent
            android:action="com.ars3nb.volta.DISCONNECT"
            android:targetPackage="com.ars3nb.volta"
            android:targetClass="com.ars3nb.volta.MainActivity" />
    </shortcut>
</shortcuts>
