    <!-- Settings screen -->
    <string name="settings_title">设置</string>
    <string name="settings_simple_title">简易模式</string>
    <string name="settings_simple_text">只有一个大大的“开启 / 关闭”按钮，服务器自动选择。适合父母和所有不需要调设置的人。</string>
    <string name="settings_section_connection">连接</string>
    <string name="settings_follow_network_title">跟随网络切换</string>
    <string name="settings_follow_network_text">在 Wi-Fi 和移动数据之间切换时，会自动检查并更换服务器。</string>
    <string name="settings_recheck_title">优化服务器选择</string>
    <string name="settings_recheck_text">屏幕亮着时每 15 分钟比较一次服务器，并切换到明显更快的那个。不响应的服务器总会被替换。</string>
    <string name="settings_failover_title">断线时更换服务器</string>
    <string name="settings_failover_text">如果服务器不再响应，Volta 会切换到另一个。</string>
    <string name="settings_autoconnect_title">开机时连接</string>
    <string name="settings_autoconnect_text">系统启动后立即开启 VPN。</string>

    <!-- Android's own kill switch. The quoted names are Android's own settings (Always-on VPN,
         Block connections without VPN), as Android calls them in that language. -->
    <string name="settings_killswitch_title">没有 VPN 时禁止上网</string>
    <string name="settings_killswitch_unknown">Android 可以让 Volta 始终保持开启，并在 VPN 连接前阻止上网。点按此处，然后点 Volta 旁的齿轮：“始终开启的 VPN”和“屏蔽未使用 VPN 的所有连接”。</string>
    <string name="settings_killswitch_on">已开启：Volta 始终开启，没有 VPN 就无法上网。关闭 VPN 后网络会断开，这是有意为之。</string>
    <string name="settings_killswitch_partial">Volta 会自动开启，但在 VPN 连接期间，应用会直接上网。请在 Volta 旁的齿轮里开启“屏蔽未使用 VPN 的所有连接”。</string>
    <string name="settings_killswitch_off">未开启。点按此处，然后点 Volta 旁的齿轮：“始终开启的 VPN”和“屏蔽未使用 VPN 的所有连接”。</string>
    <string name="settings_no_vpn_settings">此设备没有 VPN 设置</string>

