    <!-- Settings screen -->
    <string name="settings_title">Einstellungen</string>
    <string name="settings_simple_title">Einfacher Modus</string>
    <string name="settings_simple_text">Ein großer Knopf „Einschalten / Ausschalten“, der Server wird automatisch gewählt. Praktisch für Eltern und alle, die keine Einstellungen brauchen.</string>
    <string name="settings_section_connection">Verbindung</string>
    <string name="settings_follow_network_title">Netzwechsel folgen</string>
    <string name="settings_follow_network_text">Beim Wechsel zwischen WLAN und mobilen Daten wird der Server automatisch geprüft und gewechselt.</string>
    <string name="settings_recheck_title">Serverwahl verbessern</string>
    <string name="settings_recheck_text">Vergleicht alle 15 Minuten bei eingeschaltetem Bildschirm die Server und wechselt zu einem spürbar schnelleren. Ein Server, der nicht antwortet, wird immer ersetzt.</string>
    <string name="settings_failover_title">Server bei Abbruch wechseln</string>
    <string name="settings_failover_text">Wenn der Server nicht mehr antwortet, wechselt Volta zu einem anderen.</string>
    <string name="settings_autoconnect_title">Beim Start verbinden</string>
    <string name="settings_autoconnect_text">VPN direkt nach dem Systemstart einschalten.</string>

    <!-- Android's own kill switch. The quoted names are Android's own settings (Always-on VPN,
         Block connections without VPN), as Android calls them in that language. -->
    <string name="settings_killswitch_title">Kein Internet ohne VPN</string>
    <string name="settings_killswitch_unknown">Android kann Volta dauerhaft eingeschaltet lassen und das Internet sperren, solange das VPN nicht verbunden ist. Tippen Sie hier und dann auf das Zahnrad neben Volta: „Durchgehend aktives VPN“ und „Verbindungen ohne VPN blockieren“.</string>
    <string name="settings_killswitch_on">Aktiv: Volta ist immer eingeschaltet, ohne VPN ist das Internet gesperrt. Schalten Sie das VPN aus, ist das Internet weg – so ist es gewollt.</string>
    <string name="settings_killswitch_partial">Volta schaltet sich selbst ein, aber solange das VPN verbindet, gehen Apps direkt ins Internet. Aktivieren Sie „Verbindungen ohne VPN blockieren“ im Zahnrad neben Volta.</string>
    <string name="settings_killswitch_off">Aus. Tippen Sie hier und dann auf das Zahnrad neben Volta: „Durchgehend aktives VPN“ und „Verbindungen ohne VPN blockieren“.</string>
    <string name="settings_no_vpn_settings">Dieses Gerät hat keine VPN-Einstellungen</string>

