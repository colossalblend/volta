<?xml version="1.0" encoding="utf-8"?>
<!-- Settings, subscriptions, adding, updates and moving to a new phone. English is the
     default; every values-xx folder has this file with the same keys (LocalizationTest). -->
<resources>

    <!-- Settings screen -->
    <string name="settings_title">Settings</string>
    <string name="settings_simple_title">Simple mode</string>
    <string name="settings_simple_text">One big “Turn on / Turn off” button, and the server is picked automatically. Handy for parents and anyone who doesn\'t need settings.</string>
    <string name="settings_section_connection">Connection</string>
    <string name="settings_follow_network_title">Follow network changes</string>
    <string name="settings_follow_network_text">When you switch between Wi-Fi and mobile data, the server is checked and changed automatically.</string>
    <string name="settings_recheck_title">Improve server choice</string>
    <string name="settings_recheck_text">Every 15 minutes while the screen is on, compares servers and moves to a noticeably faster one. A server that stops responding is always replaced.</string>
    <string name="settings_failover_title">Switch server if it drops</string>
    <string name="settings_failover_text">If the server stops responding, Volta will move to another one.</string>
    <string name="settings_autoconnect_title">Connect at startup</string>
    <string name="settings_autoconnect_text">Turn on VPN right after the device starts up.</string>

    <!-- Android's own kill switch. The quoted names are Android's own settings (Always-on VPN,
         Block connections without VPN), as Android calls them in that language. -->
    <string name="settings_killswitch_title">Block internet without VPN</string>
    <string name="settings_killswitch_unknown">Android can keep Volta always on and block the internet until VPN is connected. Tap, then the gear next to Volta: “Always-on VPN” and “Block connections without VPN”.</string>
    <string name="settings_killswitch_on">On: Volta is always on, and without VPN there\'s no internet. Turn VPN off and the internet goes away — that\'s by design.</string>
    <string name="settings_killswitch_partial">Volta turns on by itself, but while VPN is connecting, apps go online directly. Turn on “Block connections without VPN” under the gear next to Volta.</string>
    <string name="settings_killswitch_off">Off. Tap, then the gear next to Volta: “Always-on VPN” and “Block connections without VPN”.</string>
    <string name="settings_no_vpn_settings">This device has no VPN settings</string>

    <!-- Quick Settings tiles -->
    <string name="settings_section_tiles">Quick Settings tiles</string>
    <string name="settings_tiles_hint">Tapping a tile turns on VPN in its mode; tapping again turns it off.</string>
    <string name="settings_tile_add">add</string>

    <!-- Subscriptions and checks -->
    <string name="settings_section_checks">Subscriptions and checks</string>
    <string name="settings_refresh_on_launch_title">Update subscriptions on launch</string>
    <string name="settings_refresh_on_launch_text">Servers and rules are updated when you open the app.</string>
    <string name="settings_ping_on_start_title">Check network on launch</string>
    <string name="settings_ping_on_start_text">See right away which network you\'re on: Home or LTE.</string>
    <string name="settings_ping_type_title">How to check servers</string>
    <string name="settings_ping_real">Through the server</string>
    <string name="settings_ping_real_hint">Checks the real speed through the server. Recommended.</string>
    <string name="settings_ping_http_hint">For servers that don\'t respond well to the quick check.</string>
    <string name="settings_ping_tcp_hint">Faster, but may show a server as alive when it isn\'t working.</string>
    <string name="settings_ping_icmp_hint">The simplest check. Doesn\'t work on many mobile carriers.</string>

