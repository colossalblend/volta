    <!-- Settings screen -->
    <string name="settings_title">تنظیمات</string>
    <string name="settings_simple_title">حالت ساده</string>
    <string name="settings_simple_text">یک دکمهٔ بزرگ «روشن / خاموش»، سرور خودکار انتخاب می‌شود. برای والدین و هر کسی که به تنظیمات نیازی ندارد مناسب است.</string>
    <string name="settings_section_connection">اتصال</string>
    <string name="settings_follow_network_title">دنبال کردن تغییر شبکه</string>
    <string name="settings_follow_network_text">هنگام جابه‌جایی بین Wi-Fi و اینترنت همراه، سرور خودکار بررسی و عوض می‌شود.</string>
    <string name="settings_recheck_title">بهبود انتخاب سرور</string>
    <string name="settings_recheck_text">وقتی صفحه روشن است، هر ۱۵ دقیقه سرورها را مقایسه می‌کند و به سروری که به‌وضوح سریع‌تر است می‌رود. سروری که پاسخ ندهد همیشه عوض می‌شود.</string>
    <string name="settings_failover_title">تعویض سرور هنگام قطعی</string>
    <string name="settings_failover_text">اگر سرور دیگر پاسخ ندهد، Volta به سرور دیگری می‌رود.</string>
    <string name="settings_autoconnect_title">اتصال هنگام راه‌اندازی</string>
    <string name="settings_autoconnect_text">روشن کردن VPN بلافاصله پس از روشن شدن دستگاه.</string>

    <!-- Android's own kill switch. The quoted names are Android's own settings (Always-on VPN,
         Block connections without VPN), as Android calls them in that language. -->
    <string name="settings_killswitch_title">بستن اینترنت بدون VPN</string>
    <string name="settings_killswitch_unknown">اندروید می‌تواند Volta را همیشه روشن نگه دارد و تا وقتی VPN وصل نشده، اینترنت را ببندد. ضربه بزنید، سپس روی چرخ‌دندهٔ کنار Volta: «VPN همیشه روشن» و «مسدود کردن اتصال‌های بدون VPN».</string>
    <string name="settings_killswitch_on">روشن است: Volta همیشه روشن است و بدون VPN اینترنت بسته است. اگر VPN را خاموش کنید، اینترنت قطع می‌شود؛ این عمدی است.</string>
    <string name="settings_killswitch_partial">Volta خودش روشن می‌شود، اما تا وقتی VPN در حال اتصال است، برنامه‌ها مستقیم به اینترنت وصل می‌شوند. در چرخ‌دندهٔ کنار Volta گزینهٔ «مسدود کردن اتصال‌های بدون VPN» را روشن کنید.</string>
    <string name="settings_killswitch_off">خاموش است. ضربه بزنید، سپس روی چرخ‌دندهٔ کنار Volta: «VPN همیشه روشن» و «مسدود کردن اتصال‌های بدون VPN».</string>
    <string name="settings_no_vpn_settings">این دستگاه تنظیمات VPN ندارد</string>

