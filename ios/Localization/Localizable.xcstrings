    "settings_recheck_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل 15 دقيقة والشاشة مضاءة، يقارن الخوادم وينتقل إلى خادم أسرع بشكل ملحوظ. أما الخادم الذي لا يستجيب فيُستبدل دائمًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran açıq olanda hər 15 dəqiqədən bir serverləri müqayisə edir və nəzərəçarpacaq dərəcədə daha sürətlisinə keçir. Cavab verməyən server həmişə dəyişdirilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз на 15 хвілін пры ўключаным экране параўноўвае серверы і пераходзіць на прыкметна больш хуткі. Сервер, які не адказвае, замяняецца заўсёды."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleicht alle 15 Minuten bei eingeschaltetem Bildschirm die Server und wechselt zu einem spürbar schnelleren. Ein Server, der nicht antwortet, wird immer ersetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every 15 minutes while the screen is on, compares servers and moves to a noticeably faster one. A server that stops responding is always replaced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada 15 minutos, con la pantalla encendida, compara los servidores y pasa a uno notablemente más rápido. Un servidor que no responde siempre se cambia."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی صفحه روشن است، هر ۱۵ دقیقه سرورها را مقایسه می‌کند و به سروری که به‌وضوح سریع‌تر است می‌رود. سروری که پاسخ ندهد همیشه عوض می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les 15 minutes, écran allumé, compare les serveurs et passe à un serveur nettement plus rapide. Un serveur qui ne répond plus est toujours remplacé."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран қосулы кезде әр 15 минут сайын серверлерді салыстырып, айтарлықтай жылдамырағына ауысады. Жауап бермейтін сервер әрқашан ауыстырылады."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cada 15 minutos, com a tela ligada, compara os servidores e muda para um visivelmente mais rápido. Um servidor que não responde é sempre trocado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз в 15 минут при включённом экране сравнивает серверы и переходит на заметно более быстрый. Неотвечающий сервер заменяется всегда."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran açıkken 15 dakikada bir sunucuları karşılaştırır ve belirgin şekilde daha hızlı olana geçer. Yanıt vermeyen sunucu her zaman değiştirilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Раз на 15 хвилин, коли екран увімкнено, порівнює сервери й переходить на помітно швидший. Сервер, що не відповідає, замінюється завжди."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran yoniq boʻlganda har 15 daqiqada serverlarni solishtiradi va sezilarli darajada tezrogʻiga oʻtadi. Javob bermayotgan server har doim almashtiriladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕亮着时每 15 分钟比较一次服务器，并切换到明显更快的那个。不响应的服务器总会被替换。"
          }
        }
      }
    },
