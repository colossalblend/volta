    "routing_torrents_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كثير من الخوادم تحظر بسبب مشاركة التورنت، وعند الاتصال المباشر يراها مزود الإنترنت"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir çox server paylamaya görə bloklayır, birbaşa isə onları provayder görür"
