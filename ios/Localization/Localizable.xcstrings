    "network_airplane_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن تعمل VPN. أوقف وضع الطيران أو اتصل بشبكة Wi-Fi."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN işləməyəcək. Uçuş rejimini söndürün və ya Wi-Fi-a qoşulun."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN не будзе працаваць. Выключыце рэжым палёту або падключыцеся да Wi-Fi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das VPN wird nicht funktionieren. Schalte den Flugmodus aus oder verbinde dich mit einem WLAN."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The VPN won't work. Turn airplane mode off or connect to Wi-Fi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La VPN no funcionará. Desactiva el modo avión o conéctate a una red Wi-Fi."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN کار نمی‌کند. حالت هواپیما را خاموش کنید یا به Wi-Fi وصل شوید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le VPN ne fonctionnera pas. Désactivez le mode avion ou connectez-vous au Wi-Fi."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN жұмыс істемейді. Ұшақ режимін өшіріңіз немесе Wi-Fi-ға қосылыңыз."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A VPN não vai funcionar. Desative o modo avião ou conecte-se a uma rede Wi-Fi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN работать не будет. Выключите режим полёта или подключитесь к Wi-Fi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN çalışmayacak. Uçak modunu kapatın veya Wi-Fi’a bağlanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN не працюватиме. Вимкніть режим польоту або підключіться до Wi-Fi."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN ishlamaydi. Parvoz rejimini oʻchiring yoki Wi-Fi’ga ulaning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 无法使用。请关闭飞行模式或连接 Wi-Fi。"
          }
        }
      }
    },
