    "subs.empty.text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف اشتراكًا أو أكثر: سيجمع Volta خوادمها في قائمة واحدة ويوزّعها بنفسه على مجموعتي Home وLTE."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir və ya bir neçəsini əlavə edin: Volta onların serverlərini ümumi siyahıda birləşdirəcək və özü Home və LTE qruplarına bölüşdürəcək."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Дадайце адну ці некалькі: Volta аб’яднае іх серверы ў агульны спіс і сама раскладзе па групах Home і LTE."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie ein oder mehrere hinzu: Volta führt ihre Server in einer gemeinsamen Liste zusammen und sortiert sie selbst in die Gruppen Home und LTE."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add one or more: Volta will merge their servers into one list and sort them into the Home and LTE groups itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una o varias: Volta juntará sus servidores en una lista común y los repartirá solo en los grupos Home y LTE."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک یا چند اشتراک اضافه کنید: Volta سرورهایشان را در یک فهرست مشترک جمع می‌کند و خودش در گروه‌های Home و LTE مرتب می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez-en un ou plusieurs : Volta réunit leurs serveurs dans une liste commune et les répartit seule entre les groupes Home et LTE."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бір немесе бірнешеуін қосыңыз: Volta олардың серверлерін ортақ тізімге біріктіріп, Home және LTE топтарына өзі бөледі."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma ou mais: o Volta junta os servidores delas em uma lista só e os separa sozinho nos grupos Home e LTE."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте одну или несколько: Volta объединит их серверы в общий список и сама разложит по группам Home и LTE."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ya da birkaç tane ekleyin: Volta sunucularını ortak bir listede birleştirir ve kendisi Home ve LTE gruplarına ayırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте одну чи кілька: Volta об’єднає їхні сервери в спільний список і сама розкладе за групами Home і LTE."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitta yoki bir nechtasini qoʻshing: Volta ularning serverlarini umumiy roʻyxatga birlashtiradi va oʻzi Home va LTE guruhlariga ajratadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加一个或多个：Volta 会把它们的服务器合并成一个列表，并自动分到 Home 和 LTE 组。"
          }
        }
      }
    },
