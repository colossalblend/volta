            "state": "translated",
            "value": "Удалить подписку?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonelik silinsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити підписку?"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Obuna oʻchirilsinmi?"
          }
        },
