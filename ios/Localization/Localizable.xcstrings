    "settings.keep.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد iPhone تشغيل VPN إذا انقطع الاتصال. يمكن إيقافه من Volta فقط."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı kəsilsə, iPhone VPN-i özü yenidən açacaq. Söndürmək yalnız Volta-da olar."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone сам уключыць VPN, калі сувязь абарвецца. Выключыць можна толькі ў Volta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das iPhone schaltet das VPN wieder ein, wenn die Verbindung abreißt. Ausschalten geht nur in Volta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPhone turns the VPN back on if the connection drops. You can turn it off only in Volta."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El iPhone vuelve a activar la VPN si se corta la conexión. Solo se puede apagar desde Volta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر اتصال قطع شود، iPhone خودش VPN را دوباره روشن می‌کند. خاموش کردن VPN فقط در Volta ممکن است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’iPhone réactive le VPN si la connexion coupe. Vous ne pouvez l’arrêter que dans Volta."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Байланыс үзілсе, iPhone VPN-ді өзі қайта қосады. VPN-ді тек Volta-да өшіруге болады."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iPhone religa a VPN se a conexão cair. Só dá para desligar no Volta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone сам включит VPN снова, если соединение пропадёт. Выключить VPN можно только в Volta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı koparsa iPhone VPN’i kendisi yeniden açar. VPN yalnızca Volta’dan kapatılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone сам увімкне VPN знову, якщо з’єднання зникне. Вимкнути VPN можна лише у Volta."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloqa uzilsa, iPhone VPN’ni o‘zi qayta yoqadi. VPN’ni faqat Volta’da o‘chirish mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接断开时 iPhone 会自动重新开启 VPN。只能在 Volta 中关闭 VPN。"
          }
        }
      }
    },
