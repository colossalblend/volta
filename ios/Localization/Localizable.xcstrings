    "home_err_rules_of_other_subscription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه القواعد تابعة لاشتراك آخر ولا يمكن تطبيقها هنا"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu qaydalar başqa abunəliyə aiddir və burada tətbiq edilə bilməz"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэтыя правілы належаць іншай падпісцы і не могуць быць ужытыя тут"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Regeln gehören zu einem anderen Abo und können hier nicht angewendet werden"
