    "subs.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على الاشتراك لإعادة تسميته أو حذفه."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Adını dəyişmək və ya silmək üçün abunəyə toxunun."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Націсніце на падпіску, каб перайменаваць або выдаліць яе."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf ein Abo, um es umzubenennen oder zu löschen."
