        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این قوانین متعلق به اشتراک دیگری است و اینجا اعمال نمی‌شود"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces règles appartiennent à un autre abonnement et ne peuvent pas être appliquées ici"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл ережелер басқа жазылымға тиесілі, оларды мұнда қолдануға болмайды"
          }
        },
        "pt-BR": {
