    "tunnel.error.noPlan": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد إعدادات اتصال. شغّل VPN من تطبيق Volta."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qoşulma ayarları yoxdur. VPN-i Volta tətbiqindən açın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Няма налад падключэння. Уключыце VPN з праграмы Volta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Verbindungsdaten. Schalte das VPN in der Volta-App ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No connection settings. Turn the VPN on from the Volta app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ajustes de conexión. Activa la VPN desde la app Volta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تنظیمات اتصال نیست. VPN را از برنامه Volta روشن کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun réglage de connexion. Activez le VPN depuis l’app Volta."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қосылу баптаулары жоқ. VPN-ді Volta қолданбасынан қосыңыз."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem ajustes de conexão. Ligue a VPN pelo app Volta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет настроек подключения. Включите VPN из приложения Volta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı ayarı yok. VPN’i Volta uygulamasından açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає налаштувань підключення. Увімкніть VPN із застосунку Volta."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulanish sozlamalari yo‘q. VPN’ni Volta ilovasidan yoqing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有连接设置。请从 Volta 应用中开启 VPN。"
          }
        }
      }
    },
