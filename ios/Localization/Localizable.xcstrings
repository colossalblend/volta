    "routing_adblock_family_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ويُخفي أيضًا مواقع البالغين ويُفعّل البحث الآمن."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Həmçinin böyüklər üçün saytları gizlədir və təhlükəsiz axtarışı aktiv edir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Яшчэ хавае сайты для дарослых і ўключае бяспечны пошук."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet außerdem Websites für Erwachsene aus und schaltet die sichere Suche ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also hides adult sites and turns on safe search."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También oculta sitios para adultos y activa la búsqueda segura."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سایت‌های بزرگسالان را هم پنهان می‌کند و جست‌وجوی امن را روشن می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque aussi les sites pour adultes et active la recherche sécurisée."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сондай-ақ ересектерге арналған сайттарды жасырып, қауіпсіз іздеуді қосады."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Também esconde sites adultos e ativa a pesquisa segura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ещё скрывает сайты для взрослых и включает безопасный поиск."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrıca yetişkin sitelerini gizler ve güvenli aramayı açar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Також приховує сайти для дорослих і вмикає безпечний пошук."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Shuningdek, kattalar uchun saytlarni yashiradi va xavfsiz qidiruvni yoqadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还会隐藏成人网站并开启安全搜索。"
          }
        }
      }
    },
