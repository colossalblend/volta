    "settings_backup_error_damaged": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا ليس ملف Volta أو أنه تالف"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Volta faylı deyil və ya zədələnib"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэта не файл Volta, або ён пашкоджаны"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist keine Volta-Datei, oder sie ist beschädigt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This isn't a Volta file, or it's damaged"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no es un archivo de Volta o está dañado"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این فایل Volta نیست یا خراب شده است"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas un fichier Volta, ou il est endommagé"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл Volta файлы емес немесе ол бүлінген"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este não é um arquivo do Volta ou está danificado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не файл Volta или он повреждён"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir Volta dosyası değil ya da bozuk"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це не файл Volta або його пошкоджено"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Volta fayli emas yoki u buzilgan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是 Volta 文件，或文件已损坏"
          }
        }
      }
    },
    "settings_backup_error_newer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حُفظ الملف بإصدار أحدث من Volta. حدّث التطبيق"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fayl Volta-nın daha yeni versiyası ilə saxlanılıb. Tətbiqi yeniləyin"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл захаваны навейшай версіяй Volta. Абнавіце праграму"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei stammt aus einer neueren Volta-Version. Aktualisieren Sie die App"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file was saved by a newer version of Volta. Update the app"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo se guardó con una versión más nueva de Volta. Actualiza la app"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این فایل با نسخهٔ جدیدتری از Volta ذخیره شده است. برنامه را به‌روز کنید"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier a été enregistré par une version plus récente de Volta. Mettez l'appli à jour"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл Volta-ның жаңарақ нұсқасында сақталған. Қолданбаны жаңартыңыз"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo foi salvo por uma versão mais nova do Volta. Atualize o app"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл сохранён более новой версией Volta. Обновите приложение"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya Volta'nın daha yeni bir sürümüyle kaydedilmiş. Uygulamayı güncelleyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл збережено новішою версією Volta. Оновіть застосунок"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Fayl Voltaning yangiroq versiyasida saqlangan. Ilovani yangilang"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该文件由更新版本的 Volta 保存。请更新应用"
          }
        }
      }
    },
