    "detect.encrypted.text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيفتحه Volta بنفسه، وسيبقى العنوان مخفيًا"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta onu özü açacaq, ünvan gizli qalacaq"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta адкрые яе сама, адрас застанецца схаваным"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta öffnet es selbst, die Adresse bleibt verborgen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta will open it itself; the address stays hidden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta la abrirá sola; la dirección seguirá oculta"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta خودش آن را باز می‌کند و نشانی پنهان می‌ماند"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta l'ouvrira toute seule, l'adresse restera masquée"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta оны өзі ашады, мекенжай жасырын қалады"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Volta abre sozinho, e o endereço continua oculto"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta откроет её сама, адрес останется скрытым"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta onu kendisi açar, adres gizli kalır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta відкриє її сама, адреса залишиться прихованою"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta uni oʻzi ochadi, manzil yashirin qoladi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta 会自行打开，地址保持隐藏"
          }
        }
      }
    },
