        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не дадаецца, а ўключае ці выключае VPN"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nicht hinzugefügt, sondern schaltet das VPN ein oder aus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Isn't added; it turns VPN on or off"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se añade: activa o desactiva la VPN"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اضافه نمی‌شود، بلکه VPN را روشن یا خاموش می‌کند"
