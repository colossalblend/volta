    "network_none_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لـ VPN الاتصال. شغّل Wi-Fi أو بيانات الجوال."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN qoşula bilməyəcək. Wi-Fi və ya mobil interneti aktiv edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN не зможа падключыцца. Уключыце Wi-Fi або мабільны інтэрнэт."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das VPN kann sich nicht verbinden. Schalte WLAN oder mobile Daten ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The VPN can't connect. Turn on Wi-Fi or mobile data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La VPN no podrá conectarse. Activa el Wi-Fi o los datos móviles."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN نمی‌تواند وصل شود. Wi-Fi یا اینترنت همراه را روشن کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le VPN ne pourra pas se connecter. Activez le Wi-Fi ou les données mobiles."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN қосыла алмайды. Wi-Fi немесе мобильді интернетті қосыңыз."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A VPN não vai conseguir conectar. Ative o Wi-Fi ou os dados móveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN не сможет подключиться. Включите Wi-Fi или мобильный интернет."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN bağlanamaz. Wi-Fi’ı veya mobil veriyi açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN не зможе підключитися. Увімкніть Wi-Fi або мобільний інтернет."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN ulana olmaydi. Wi-Fi yoki mobil internetni yoqing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 无法连接。请打开 Wi-Fi 或移动数据。"
          }
        }
      }
    },
