    "mode.noLte": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد خوادم LTE في الاشتراكات: يعمل Volta كـ Home تلقائي ولا يفحص المواقع"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Abunəliklərdə LTE serverləri yoxdur: Volta Avto Home kimi işləyir və saytları yoxlamır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У падпісках няма LTE-сервераў: Volta працуе як Аўта Home і не правярае сайты"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Abos haben keine LTE-Server: Volta arbeitet als Auto Home und prüft keine Websites"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your subscriptions have no LTE servers: Volta works as Auto Home and doesn't check sites"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus suscripciones no tienen servidores LTE: Volta funciona como Auto Home y no comprueba sitios"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اشتراک‌ها سرور LTE ندارند: Volta مثل Home خودکار کار می‌کند و سایت‌ها را بررسی نمی‌کند"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos abonnements n’ont pas de serveurs LTE : Volta fonctionne en Auto Home et ne vérifie pas les sites"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазылымдарда LTE серверлері жоқ: Volta Авто Home ретінде жұмыс істейді және сайттарды тексермейді"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas assinaturas não têm servidores LTE: o Volta funciona como Auto Home e não verifica sites"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В подписках нет LTE-серверов: Volta работает как Авто Home и не проверяет сайты"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aboneliklerde LTE sunucusu yok: Volta Otomatik Home olarak çalışıyor ve siteleri kontrol etmiyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У підписках немає LTE-серверів: Volta працює як Авто Home і не перевіряє сайти"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Obunalarda LTE serverlari yoʻq: Volta Avto Home sifatida ishlaydi va saytlarni tekshirmaydi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅中没有 LTE 服务器：Volta 以自动 Home 模式运行，不检查网站"
          }
        }
      }
    },
