            "value": "اشتراک حذف شود؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer l'abonnement ?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазылымды жою керек пе?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir a assinatura?"
          }
        },
        "ru": {
