        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma assinatura ou cole o link de um servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте подписку или вставьте ссылку на сервер."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir abonelik ekleyin veya bir sunucu bağlantısı yapıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
