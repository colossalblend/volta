    "editor.delete.text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُحذف خوادمه. تبقى الاشتراكات الأخرى كما هي."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Onun serverləri silinəcək. Digər abunəliklər olduğu kimi qalacaq."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сыдуць яе серверы. Астатнія падпіскі застануцца як ёсць."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Server gehen mit. Andere Abos bleiben, wie sie sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its servers go with it. Other subscriptions stay as they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus servidores se van con ella. Las demás suscripciones quedan igual."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرورهایش هم حذف می‌شوند. اشتراک‌های دیگر دست نمی‌خورند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses serveurs partiront avec lui. Les autres abonnements restent tels quels."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оның серверлері де жойылады. Басқа жазылымдар өзгеріссіз қалады."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os servidores dela saem junto. As outras assinaturas ficam como estão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уйдут её серверы. Остальные подписки останутся как есть."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucuları da gider. Diğer abonelikler olduğu gibi kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підуть її сервери. Інші підписки залишаться як є."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Uning serverlari ham o‘chadi. Boshqa obunalar o‘zgarmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它的服务器也会一起删除，其他订阅保持不变。"
          }
        }
      }
    },
    "editor.delete.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد حذف الاشتراك؟"
          }
        },
