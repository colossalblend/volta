        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode habituel : tout sort, sauf le réseau local"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әдеттегі режим: жергілікті желіден басқаның бәрі сыртқа шығады"
