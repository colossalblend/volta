    "settings.probe": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فحص الشبكة عند الفتح"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Açılışda şəbəkəni yoxla"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Правяраць сетку пры запуску"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Netz beim Start prüfen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check network on launch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobar la red al abrir"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بررسی شبکه هنگام اجرا"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier le réseau au lancement"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Іске қосқанда желіні тексеру"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificar a rede ao abrir"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверять сеть при запуске"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açılışta ağı denetle"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевіряти мережу під час запуску"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ishga tushganda tarmoqni tekshirish"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动时检测网络"
          }
        }
      }
    },
    "settings.probe.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر فورًا نوع الشبكة الحالية: Home أو LTE."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazırda hansı şəbəkə olduğu dərhal görünür: Home, yoxsa LTE."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адразу відаць, якая цяпер сетка: Home ці LTE."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sofort sichtbar, welches Netz gerade aktiv ist: Home oder LTE."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See right away which network you're on: Home or LTE."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ve al momento en qué red estás: Home o LTE."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بلافاصله معلوم می‌شود الان کدام شبکه است: Home یا LTE."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On voit tout de suite le réseau actuel : Home ou LTE."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қазір қай желі екені бірден көрінеді: Home не LTE."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dá para ver na hora qual é a rede: Home ou LTE."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сразу видно, какая сейчас сеть: Home или LTE."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu an hangi ağda olduğunuz hemen görünür: Home mu, LTE mi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одразу видно, яка зараз мережа: Home чи LTE."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozir qaysi tarmoq ekani darhol koʻrinadi: Home yoki LTE."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼看出当前是哪种网络：Home 还是 LTE。"
          }
        }
      }
    },
    "settings.refreshOnLaunch": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحديث الاشتراكات عند الفتح"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Açılışda abunələri yenilə"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Абнаўляць падпіскі пры запуску"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abos beim Start aktualisieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update subscriptions on launch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizar suscripciones al abrir"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به‌روزرسانی اشتراک‌ها هنگام اجرا"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre à jour les abonnements au lancement"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Іске қосқанда жазылымдарды жаңарту"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualizar assinaturas ao abrir"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновлять подписки при запуске"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açılışta abonelikleri güncelle"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновлювати підписки під час запуску"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ishga tushganda obunalarni yangilash"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动时更新订阅"
          }
        }
      }
    },
    "settings.refreshOnLaunch.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتحدث الخوادم عند فتح التطبيق."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tətbiqi açanda serverlər yenilənir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Серверы абнаўляюцца, калі вы адкрываеце праграму."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Server werden beim Öffnen der App aktualisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The servers update when you open the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los servidores se actualizan al abrir la app."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با باز کردن برنامه، سرورها به‌روز می‌شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les serveurs se mettent à jour à l’ouverture de l’app."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданбаны ашқанда серверлер жаңарады."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os servidores atualizam quando você abre o app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Серверы обновляются при открытии приложения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama açıldığında sunucular güncellenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервери оновлюються під час відкриття застосунку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilova ochilganda serverlar yangilanadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开应用时更新服务器。"
          }
        }
      }
    },
    "settings.routing.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المواقع الروسية مباشرة، مواقعك الخاصة، حظر الإعلانات والتورنت"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rusiya saytları birbaşa, öz saytlarınız, reklam və torrent bloklanması"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Расійскія сайты напрамую, свае сайты, блакіроўка рэкламы і торэнтаў"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Russische Seiten direkt, eigene Seiten, Werbe- und Torrent-Sperre"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Russian sites direct, your own sites, ad and torrent blocking"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitios rusos directos, tus propios sitios, bloqueo de anuncios y torrents"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سایت‌های روسی مستقیم، سایت‌های خودتان، مسدودسازی تبلیغات و تورنت"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sites russes en direct, vos propres sites, blocage des pubs et des torrents"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ресей сайттары тікелей, өз сайттарыңыз, жарнама мен торренттерді бұғаттау"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sites russos direto, seus próprios sites, bloqueio de anúncios e torrents"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Российские сайты напрямую, свои сайты, блокировка рекламы и торрентов"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rus siteleri doğrudan, kendi siteleriniz, reklam ve torrent engelleme"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Російські сайти напряму, свої сайти, блокування реклами й торентів"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Rossiya saytlari toʻgʻridan-toʻgʻri, oʻz saytlaringiz, reklama va torrentlarni bloklash"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "俄罗斯网站直连、自定义网站、屏蔽广告和种子"
          }
        }
      }
    },
    "settings.signingNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُوزّع Volta لـ iPhone عبر App Store. يعمل VPN فقط في نسخة موقّعة بحساب مطوّر Apple مدفوع."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone üçün Volta App Store vasitəsilə yayılmır. VPN yalnız ödənişli Apple developer hesabı ilə imzalanmış quraşdırmada işləyir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta для iPhone не распаўсюджваецца праз App Store. VPN працуе толькі ў зборцы, падпісанай платным акаўнтам распрацоўшчыка Apple."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta für iPhone gibt es nicht im App Store. Das VPN funktioniert nur in einem Build, der mit einem bezahlten Apple-Entwicklerkonto signiert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta for iPhone isn't distributed through the App Store. The VPN only works in a build signed with a paid Apple developer account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta para iPhone no se distribuye por la App Store. La VPN solo funciona en una versión firmada con una cuenta de desarrollador de Apple de pago."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta برای iPhone از طریق App Store منتشر نمی‌شود. VPN فقط در نسخه‌ای کار می‌کند که با حساب پولی توسعه‌دهنده Apple امضا شده باشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta pour iPhone n’est pas distribué sur l’App Store. Le VPN ne fonctionne que dans une version signée par un compte développeur Apple payant."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-ға арналған Volta App Store арқылы таратылмайды. VPN тек Apple-дің ақылы әзірлеуші аккаунтымен қол қойылған жинақта жұмыс істейді."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Volta para iPhone não é distribuído pela App Store. A VPN só funciona numa versão assinada com uma conta paga de desenvolvedor Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta для iPhone распространяется не через App Store. VPN работает только в сборке, подписанной платным аккаунтом разработчика Apple."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone için Volta App Store üzerinden dağıtılmaz. VPN yalnızca ücretli Apple geliştirici hesabıyla imzalanmış sürümde çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta для iPhone поширюється не через App Store. VPN працює лише у збірці, підписаній платним акаунтом розробника Apple."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone uchun Volta App Store orqali tarqatilmaydi. VPN faqat Apple’ning pullik dasturchi akkaunti bilan imzolangan yig‘mada ishlaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 版 Volta 不通过 App Store 发布。只有使用付费 Apple 开发者账号签名的版本才能使用 VPN。"
          }
        }
      }
    },
