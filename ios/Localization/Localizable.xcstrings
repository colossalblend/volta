    "balancer.noAnswer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يستجب أي خادم في المجموعة. حاول لاحقًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qrupun serverləri cavab vermədi. Sonra yenidən cəhd edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Серверы групы не адказалі. Паспрабуйце пазней."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Server der Gruppe hat geantwortet. Versuche es später."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No server in the group answered. Try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún servidor del grupo respondió. Inténtalo más tarde."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرورهای گروه پاسخ ندادند. بعداً امتحان کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun serveur du groupe n’a répondu. Réessayez plus tard."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Топ серверлері жауап бермеді. Кейінірек көріңіз."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum servidor do grupo respondeu. Tente mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Серверы группы не ответили. Попробуйте позже."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gruptaki sunucular yanıt vermedi. Daha sonra deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервери групи не відповіли. Спробуйте пізніше."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Guruh serverlari javob bermadi. Keyinroq urinib ko‘ring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该分组的服务器没有响应。请稍后再试。"
          }
        }
      }
    },
