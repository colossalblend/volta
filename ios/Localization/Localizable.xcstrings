    "routing_delete_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستنتقل الاشتراكات التي كانت تستخدمه إلى ملف التعريف الافتراضي."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondan istifadə edən abunəliklər defolt profilə keçəcək."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Падпіскі, якія яго выкарыстоўвалі, пяройдуць на профіль па змаўчанні."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abos, die es genutzt haben, wechseln zum Standardprofil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscriptions that used it will switch to the default profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las suscripciones que lo usaban pasarán al perfil predeterminado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اشتراک‌هایی که از آن استفاده می‌کردند به پروفایل پیش‌فرض می‌روند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les abonnements qui l’utilisaient passeront au profil par défaut."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оны қолданған жазылымдар әдепкі профильге ауысады."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As assinaturas que o usavam passarão para o perfil padrão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписки, которые его использовали, перейдут на профиль по умолчанию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onu kullanan abonelikler varsayılan profile geçer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підписки, які його використовували, перейдуть на профіль за замовчуванням."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Undan foydalangan obunalar standart profilga oʻtadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用它的订阅将改用默认方案。"
          }
        }
      }
    },
