    "settings_update_error_check": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحقق من التحديثات. تحقّق من الإنترنت أو شغّل VPN."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniləmələri yoxlamaq alınmadı. İnterneti yoxlayın və ya VPN-i qoşun."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Не атрымалася праверыць абнаўленні. Праверце інтэрнэт або ўключыце VPN."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates konnten nicht geprüft werden. Prüfen Sie die Internetverbindung oder schalten Sie das VPN ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't check for updates. Check your internet or turn on VPN."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron buscar actualizaciones. Revisa tu conexión o activa la VPN."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بررسی به‌روزرسانی انجام نشد. اینترنت را بررسی کنید یا VPN را روشن کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de rechercher les mises à jour. Vérifiez votre connexion ou activez le VPN."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаңартуларды тексеру мүмкін болмады. Интернетті тексеріңіз немесе VPN қосыңыз."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar atualizações. Verifique a internet ou ligue a VPN."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не получилось проверить обновления. Проверьте интернет или включите VPN."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncellemeler denetlenemedi. İnternetinizi kontrol edin ya da VPN'i açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося перевірити оновлення. Перевірте інтернет або ввімкніть VPN."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yangilanishlarni tekshirib boʻlmadi. Internetni tekshiring yoki VPN yoqing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查更新。请检查网络或开启 VPN。"
          }
        }
      }
    },
