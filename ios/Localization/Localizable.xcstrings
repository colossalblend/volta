    "import.fmt.sub.text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رابط من خدمة VPN، عادي أو مشفّر. تُحدَّث خوادمه تلقائيًا"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN xidmətindən gələn keçid, adi və ya şifrələnmiş. İçindəki serverlər özü yenilənir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Спасылка ад VPN-сэрвісу, звычайная ці зашыфраваная. Серверы ў ёй абнаўляюцца самі"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Link Ihres VPN-Anbieters, normal oder verschlüsselt. Seine Server werden automatisch aktualisiert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A link from your VPN service, plain or encrypted. Its servers update on their own"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enlace de tu servicio de VPN, normal o cifrado. Sus servidores se actualizan solos"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "لینکی از سرویس VPN، معمولی یا رمزگذاری‌شده. سرورهای آن خودکار به‌روز می‌شوند"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lien de votre service VPN, normal ou chiffré. Ses serveurs se mettent à jour tout seuls"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN-сервистен келген сілтеме, қарапайым не шифрланған. Ондағы серверлер өздігінен жаңарады"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um link do seu serviço de VPN, comum ou criptografado. Os servidores dele se atualizam sozinhos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка от VPN-сервиса, обычная или зашифрованная. Серверы в ней обновляются сами"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN hizmetinden gelen bağlantı, düz ya da şifreli. İçindeki sunucular kendiliğinden güncellenir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Посилання від VPN-сервісу, звичайне чи зашифроване. Сервери в ньому оновлюються самі"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN-xizmatdan kelgan havola, oddiy yoki shifrlangan. Undagi serverlar oʻzi yangilanadi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 服务商提供的链接，普通或加密均可。其中的服务器会自动更新"
          }
        }
      }
    },
