    "settings_update_beta_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احصل على النسخ التجريبية قبل الجميع. قد تحتوي على أخطاء"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınaq yığmalarını hamıdan əvvəl alın. Onlarda xətalar ola bilər"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Атрымліваць пробныя зборкі раней за ўсіх. У іх могуць быць памылкі"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Testversionen vor allen anderen erhalten. Sie können Fehler enthalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get test builds before everyone else. They may have bugs"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibir versiones de prueba antes que nadie. Pueden tener errores"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخه‌های آزمایشی را زودتر از همه بگیرید. ممکن است خطا داشته باشند"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevoir les versions de test avant tout le monde. Elles peuvent contenir des bugs"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сынақ құрастыруларын бәрінен бұрын алу. Оларда қателер болуы мүмкін"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receber versões de teste antes de todo mundo. Elas podem ter erros"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получать пробные сборки раньше всех. В них могут быть ошибки"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deneme sürümlerini herkesten önce alın. Hata içerebilirler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отримувати пробні збірки раніше за всіх. У них можуть бути помилки"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinov yigʻmalarini hammadan oldin olish. Ularda xatolar boʻlishi mumkin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抢先获取测试版本。其中可能有错误"
          }
        }
      }
    },
