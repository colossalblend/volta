    "settings_backup_servers_reload": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُحمَّل خوادم الاشتراكات من جديد، ويلزم اتصال بالإنترنت."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Abunə serverləri yenidən yüklənəcək, internet lazımdır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Серверы падпісак загрузяцца нанова, патрэбны інтэрнэт."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Server der Abos werden neu geladen, dafür ist Internet nötig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscription servers will load again; this needs internet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los servidores de las suscripciones se volverán a cargar; hace falta internet."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرورهای اشتراک دوباره بارگیری می‌شوند و اینترنت لازم است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les serveurs des abonnements seront rechargés : il faut Internet."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазылым серверлері қайта жүктеледі, интернет қажет."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os servidores das assinaturas serão carregados de novo; é preciso internet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Серверы подписок загрузятся заново, нужен интернет."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonelik sunucuları yeniden yüklenecek, internet gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервери підписок завантажаться заново, потрібен інтернет."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Obuna serverlari qaytadan yuklanadi, internet kerak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅的服务器会重新加载，需要联网。"
          }
        }
      }
    },
    "settings_backup_settings_replaced": {
      "extractionState": "manual",
