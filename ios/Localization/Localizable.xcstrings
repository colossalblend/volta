        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é adicionado: liga ou desliga a VPN"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не добавляется, а включает или выключает VPN"
