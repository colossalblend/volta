    "settings_backup_no_duplicates": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما هو موجود في Volta لن يتكرر."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta-da artıq olanlar təkrarlanmayacaq."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Тое, што ўжо ёсць у Volta, не задвоіцца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was schon in Volta ist, wird nicht doppelt angelegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anything already in Volta won't be added twice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que ya está en Volta no se duplicará."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چیزهایی که از قبل در Volta هست، تکراری نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui est déjà dans Volta ne sera pas ajouté en double."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta-да бұрыннан бар нәрсе қайталанбайды."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que já está no Volta não será duplicado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "То, что уже есть в Volta, не задвоится."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta'da zaten olanlar iki kez eklenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Те, що вже є у Volta, не подвоїться."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltada bor narsalar takrorlanmaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta 中已有的内容不会重复添加。"
          }
        }
      }
    },
