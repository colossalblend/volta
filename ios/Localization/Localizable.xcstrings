    "vpn.error.config": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف VPN تالف. احذف «Volta» من الإعدادات ← VPN ثم اتصل مجددًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN profili zədələnib. Ayarlar → VPN bölməsində «Volta»-nı silin və yenidən qoşulun."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Профіль VPN пашкоджаны. Выдаліце «Volta» ў Налады → VPN і падключыцеся зноў."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das VPN-Profil ist kaputt. Lösche „Volta“ unter Einstellungen → VPN und verbinde neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The VPN profile is broken. Delete “Volta” in Settings → VPN and connect again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil VPN está dañado. Borra «Volta» en Ajustes → VPN y vuelve a conectar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نمایه VPN خراب است. «Volta» را در تنظیمات ← VPN حذف کنید و دوباره وصل شوید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil VPN est abîmé. Supprimez « Volta » dans Réglages → VPN et reconnectez-vous."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN профилі бұзылған. Баптаулар → VPN бөлімінде «Volta»-ны жойып, қайта қосылыңыз."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O perfil da VPN está danificado. Apague “Volta” em Ajustes → VPN e conecte de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Профиль VPN испорчен. Удалите «Volta» в Настройках → VPN и подключитесь снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN profili bozuk. Ayarlar → VPN’de “Volta”yı silip yeniden bağlanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Профіль VPN зіпсовано. Видаліть «Volta» в Налаштуваннях → VPN і підключіться знову."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN profili buzilgan. Sozlamalar → VPN bo‘limida “Volta”ni o‘chirib, qayta ulaning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 配置已损坏。请在“设置 → VPN”中删除“Volta”后重新连接。"
          }
        }
      }
    },
    "vpn.error.entitlement": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه النسخة من Volta موقّعة دون إذن VPN. يحدث هذا مع Apple ID مجاني: يعمل VPN فقط في نسخة موقّعة بحساب مطوّر مدفوع."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta-nın bu nüsxəsi VPN icazəsi olmadan imzalanıb. Pulsuz Apple ID ilə belə olur: VPN yalnız ödənişli developer hesabı ilə imzalanmış quraşdırmada işləyir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Гэтая копія Volta падпісана без права на VPN. Так бывае з бясплатным Apple ID: VPN працуе толькі ў зборцы, падпісанай платным акаўнтам распрацоўшчыка."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Volta-Kopie ist ohne VPN-Berechtigung signiert. Das passiert mit einer kostenlosen Apple-ID: Das VPN funktioniert nur in einem Build, der mit einem bezahlten Entwicklerkonto signiert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This copy of Volta is signed without the VPN permission. That happens with a free Apple ID: the VPN only works in a build signed with a paid developer account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia de Volta está firmada sin el permiso de VPN. Pasa con un Apple ID gratuito: la VPN solo funciona en una versión firmada con una cuenta de desarrollador de pago."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این نسخه Volta بدون مجوز VPN امضا شده است. با Apple ID رایگان همین‌طور است: VPN فقط در نسخه‌ای کار می‌کند که با حساب پولی توسعه‌دهنده امضا شده باشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette copie de Volta est signée sans le droit VPN. C’est le cas avec un identifiant Apple gratuit : le VPN ne fonctionne que dans une version signée par un compte développeur payant."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta-ның бұл көшірмесі VPN құқығынсыз қол қойылған. Тегін Apple ID-мен солай болады: VPN тек ақылы әзірлеуші аккаунтымен қол қойылған жинақта жұмыс істейді."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cópia do Volta foi assinada sem a permissão de VPN. Isso acontece com um Apple ID grátis: a VPN só funciona numa versão assinada com conta paga de desenvolvedor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта копия Volta подписана без права на VPN. Так бывает с бесплатным Apple ID: VPN работает только в сборке, подписанной платным аккаунтом разработчика."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta’nın bu kopyası VPN izni olmadan imzalanmış. Ücretsiz Apple ID ile böyle olur: VPN yalnızca ücretli geliştirici hesabıyla imzalanmış sürümde çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю копію Volta підписано без права на VPN. Так буває з безкоштовним Apple ID: VPN працює лише у збірці, підписаній платним акаунтом розробника."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta’ning bu nusxasi VPN huquqisiz imzolangan. Bepul Apple ID bilan shunday bo‘ladi: VPN faqat pullik dasturchi akkaunti bilan imzolangan yig‘mada ishlaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Volta 副本的签名不含 VPN 权限。使用免费 Apple ID 签名就会这样：只有用付费开发者账号签名的版本才能使用 VPN。"
          }
        }
      }
    },
    "vpn.error.failed": {
      "extractionState": "manual",
      "localizations": {
