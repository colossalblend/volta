    "settings.hwid.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّله إذا كانت خدمة VPN تحدّ من عدد الأجهزة لكل اشتراك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN xidməti bir abunəyə düşən cihaz sayını məhdudlaşdırırsa, aktiv edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Уключыце, калі VPN-сэрвіс абмяжоўвае колькасць прылад на адну падпіску."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einschalten, wenn Ihr VPN-Anbieter die Zahl der Geräte pro Abo begrenzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on if your VPN service limits the number of devices per subscription."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo si tu servicio de VPN limita el número de dispositivos por suscripción."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر سرویس VPN تعداد دستگاه‌ها را برای هر اشتراک محدود می‌کند، روشن کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez-le si votre service VPN limite le nombre d'appareils par abonnement."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN-сервис бір жазылымға құрылғылар санын шектесе, қосыңыз."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative se o seu serviço de VPN limita o número de dispositivos por assinatura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите, если VPN-сервис ограничивает число устройств на одну подписку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN hizmetiniz abonelik başına cihaz sayısını sınırlıyorsa açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть, якщо VPN-сервіс обмежує кількість пристроїв на одну підписку."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN-xizmat bitta obunaga qurilmalar sonini cheklasa, yoqing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你的 VPN 服务商限制每个订阅的设备数量，请开启。"
          }
        }
      }
    },
    "settings.iosLimits": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما لا يتوفر على iPhone: ‏AmneziaWG وHysteria v1 وOpenFlux (تحتاج برامج مساعدة، ويمنح iOS ملحق VPN نحو 50 ميغابايت)، اختيار التطبيقات لـ VPN (على الأجهزة المُدارة فقط؛ استخدم «مواقع خارج VPN» في «المسارات» بدلًا منه)، تحديث التطبيق نفسه، والمشاركة عبر Bluetooth."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-da olmayanlar: AmneziaWG, Hysteria v1 və OpenFlux (onlara köməkçi proqramlar lazımdır, iOS isə VPN genişlənməsinə təxminən 50 MB verir), VPN üçün tətbiq seçimi (yalnız idarə olunan cihazlarda; əvəzində «Marşrutlar»da «VPN-siz saytlar»), tətbiqin özünü yeniləmək və Bluetooth ilə paylaşmaq."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Чаго няма на iPhone: AmneziaWG, Hysteria v1 і OpenFlux (ім патрэбныя праграмы-памочнікі, а пашырэнню VPN iOS дае каля 50 МБ), выбар праграм для VPN (толькі на кіраваных прыладах, замест яго — «Сайты міма VPN» у «Маршрутах»), абнаўленне самой праграмы і перадача праз Bluetooth."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was es auf dem iPhone nicht gibt: AmneziaWG, Hysteria v1 und OpenFlux (sie brauchen Hilfsprogramme, und iOS gibt der VPN-Erweiterung etwa 50 MB), Apps für das VPN auswählen (nur auf verwalteten Geräten; stattdessen „Seiten am VPN vorbei“ unter Routen), dass sich die App selbst aktualisiert, und Teilen per Bluetooth."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What an iPhone doesn't have: AmneziaWG, Hysteria v1 and OpenFlux (they need helper programs, and iOS gives the VPN extension about 50 MB), choosing apps for the VPN (managed devices only; use «Sites past the VPN» in Routing instead), updating the app itself, and Bluetooth sharing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que no hay en iPhone: AmneziaWG, Hysteria v1 y OpenFlux (necesitan programas auxiliares, y iOS da a la extensión VPN unos 50 MB), elegir apps para la VPN (solo en dispositivos gestionados; usa «Sitios fuera de la VPN» en Rutas), que la app se actualice sola y compartir por Bluetooth."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آنچه در iPhone نیست: AmneziaWG، Hysteria v1 و OpenFlux (برنامهٔ کمکی لازم دارند و iOS به افزونهٔ VPN حدود ۵۰ مگابایت می‌دهد)، انتخاب برنامه‌ها برای VPN (فقط در دستگاه‌های مدیریت‌شده؛ به‌جایش «سایت‌های بیرون از VPN» در «مسیرها»)، به‌روزرسانی خود برنامه و اشتراک با Bluetooth."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui manque sur iPhone : AmneziaWG, Hysteria v1 et OpenFlux (il leur faut des programmes d’aide, et iOS donne environ 50 Mo à l’extension VPN), le choix des apps pour le VPN (appareils gérés seulement ; utilisez « Sites hors VPN » dans Itinéraires), la mise à jour de l’app par elle-même et le partage Bluetooth."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-да жоқ нәрселер: AmneziaWG, Hysteria v1 және OpenFlux (оларға көмекші бағдарламалар керек, ал iOS VPN кеңейтіміне шамамен 50 МБ береді), VPN үшін қолданбаларды таңдау (тек басқарылатын құрылғыларда; орнына «Маршруттардағы» «VPN-сіз сайттар»), қолданбаның өзін жаңарту және Bluetooth арқылы беру."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que não existe no iPhone: AmneziaWG, Hysteria v1 e OpenFlux (precisam de programas auxiliares, e o iOS dá à extensão de VPN cerca de 50 MB), escolher apps para a VPN (só em aparelhos gerenciados; use “Sites fora da VPN” em Rotas), o app se atualizar sozinho e compartilhar por Bluetooth."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чего нет на iPhone: AmneziaWG, Hysteria v1 и OpenFlux (им нужны программы-помощники, а расширению VPN iOS даёт около 50 МБ), выбор приложений для VPN (только на управляемых устройствах, вместо него — «Сайты мимо VPN» в «Маршрутах»), обновление самого приложения и передача по Bluetooth."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone’da olmayanlar: AmneziaWG, Hysteria v1 ve OpenFlux (yardımcı programlar gerekir, iOS ise VPN uzantısına yaklaşık 50 MB veriyor), VPN için uygulama seçimi (yalnızca yönetilen cihazlarda; yerine Rotalar’daki «VPN dışı siteler»), uygulamanın kendini güncellemesi ve Bluetooth ile paylaşım."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чого немає на iPhone: AmneziaWG, Hysteria v1 і OpenFlux (їм потрібні програми-помічники, а розширенню VPN iOS дає близько 50 МБ), вибір застосунків для VPN (лише на керованих пристроях, замість нього — «Сайти повз VPN» у «Маршрутах»), оновлення самого застосунку й передавання через Bluetooth."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone’da yoʻq narsalar: AmneziaWG, Hysteria v1 va OpenFlux (ularga yordamchi dasturlar kerak, iOS esa VPN kengaytmasiga taxminan 50 MB beradi), VPN uchun ilovalarni tanlash (faqat boshqariladigan qurilmalarda; oʻrniga «Marshrutlar»dagi «VPN’siz saytlar»), ilovaning oʻzini yangilash va Bluetooth orqali ulashish."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 上没有的功能：AmneziaWG、Hysteria v1 和 OpenFlux（需要辅助程序，而 iOS 只给 VPN 扩展约 50 MB），按应用选择 VPN（仅限受管理设备；可改用“路由”中的“绕过 VPN 的网站”），应用自行更新，以及蓝牙分享。"
          }
        }
      }
    },
