    "routing_rules_empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد قواعد بعد: كل حركة البيانات تمر عبر VPN. أضف موقعًا في الأعلى أو اختر قائمة جاهزة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ heç bir qayda yoxdur: bütün trafik VPN ilə gedir. Yuxarıda sayt əlavə edin və ya hazır siyahı seçin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакуль ніводнага правіла: увесь трафік ідзе праз VPN. Дадайце сайт вышэй або выберыце гатовы спіс."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Regeln: Der gesamte Verkehr läuft über das VPN. Fügen Sie oben eine Website hinzu oder wählen Sie eine fertige Liste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rules yet: all traffic goes through the VPN. Add a site above or pick a ready-made list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay reglas: todo el tráfico va por la VPN. Añade un sitio arriba o elige una lista ya hecha."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز هیچ قانونی نیست: همهٔ ترافیک از طریق VPN می‌رود. بالاتر یک سایت اضافه کنید یا یک فهرست آماده انتخاب کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune règle pour l’instant : tout le trafic passe par le VPN. Ajoutez un site ci-dessus ou choisissez une liste toute prête."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әзірге бірде-бір ереже жоқ: бүкіл трафик VPN арқылы өтеді. Жоғарыда сайт қосыңыз немесе дайын тізімді таңдаңыз."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma regra ainda: todo o tráfego passa pela VPN. Adicione um site acima ou escolha uma lista pronta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока ни одного правила: весь трафик идёт через VPN. Добавьте сайт выше или выберите готовый список."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz kural yok: tüm trafik VPN üzerinden gidiyor. Yukarıdan bir site ekleyin veya hazır bir liste seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки жодного правила: увесь трафік іде через VPN. Додайте сайт вище або виберіть готовий список."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozircha birorta qoida yoʻq: barcha trafik VPN orqali oʻtadi. Yuqorida sayt qoʻshing yoki tayyor roʻyxatni tanlang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有规则：所有流量都走 VPN。请在上方添加网站，或选择现成的列表。"
          }
        }
      }
    },
    "routing_rules_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفحص من الأعلى إلى الأسفل: أول قاعدة مطابقة تحدد وجهة حركة البيانات. وكل ما عدا ذلك يمر عبر VPN."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuxarıdan aşağı yoxlanılır: trafikin hara gedəcəyini ilk uyğun qayda həll edir. Qalan hər şey VPN ilə gedir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Правяраюцца зверху ўніз: першае адпаведнае правіла вырашае, куды пойдзе трафік. Усё астатняе ідзе праз VPN."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie werden von oben nach unten geprüft: Die erste passende Regel bestimmt, wohin der Verkehr geht. Alles andere läuft über das VPN."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checked from top to bottom: the first matching rule decides where the traffic goes. Everything else goes through the VPN."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se revisan de arriba abajo: la primera regla que coincide decide adónde va el tráfico. Todo lo demás va por la VPN."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از بالا به پایین بررسی می‌شوند: اولین قانون مناسب تعیین می‌کند ترافیک کجا برود. بقیه از طریق VPN می‌رود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiées de haut en bas : la première règle qui correspond décide où va le trafic. Tout le reste passe par le VPN."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жоғарыдан төмен қарай тексеріледі: трафиктің қайда баратынын бірінші сәйкес ереже шешеді. Қалғанның бәрі VPN арқылы өтеді."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificadas de cima para baixo: a primeira regra que combina decide para onde vai o tráfego. Todo o resto passa pela VPN."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверяются сверху вниз: первое подходящее правило решает, куда пойдёт трафик. Всё остальное идёт через VPN."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yukarıdan aşağıya kontrol edilir: trafiğin nereye gideceğine ilk uyan kural karar verir. Geri kalan her şey VPN üzerinden gider."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевіряються згори донизу: перше відповідне правило вирішує, куди піде трафік. Усе інше йде через VPN."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuqoridan pastga tekshiriladi: trafik qayerga borishini birinchi mos qoida hal qiladi. Qolgan hammasi VPN orqali oʻtadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从上到下依次检查：第一条匹配的规则决定流量去向。其余流量都走 VPN。"
          }
        }
      }
    },
