      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»: ينقص الرابطَ مفتاح، اطلب من الخدمة رابطًا جديدًا"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»: keçiddə açar çatışmır, xidmətdən yenisini istəyin"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»: у спасылцы не хапае ключа, папрасіце ў сэрвісу новую"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“: Im Link fehlt ein Schlüssel, bitten Sie den Dienst um einen neuen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”: a key is missing from the link, ask the service for a new one"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»: al enlace le falta una clave, pide uno nuevo al servicio"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»: در لینک یک کلید کم است، از سرویس لینک جدید بخواهید"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » : il manque une clé dans le lien, demandez-en un nouveau au service"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»: сілтемеде кілт жетіспейді, сервистен жаңасын сұраңыз"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”: falta uma chave no link, peça um novo ao serviço"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»: в ссылке не хватает ключа, попросите у сервиса новую"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”: bağlantıda bir anahtar eksik, hizmetten yenisini isteyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»: у посиланні бракує ключа, попросіть у сервісу нове"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»: havolada kalit yetishmaydi, xizmatdan yangisini soʻrang"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”：链接缺少密钥，请向服务商索取新链接"
          }
        }
      }
    },
    "server.error.oldTransport": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»: يستخدم الخادم طريقة اتصال قديمة، اطلب من الخدمة رابطًا جديدًا"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»: server köhnəlmiş qoşulma üsulundan istifadə edir, xidmətdən yeni keçid istəyin"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»: сервер выкарыстоўвае састарэлы спосаб падключэння, папрасіце ў сэрвісу новую спасылку"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“: Der Server nutzt eine veraltete Verbindungsart, bitten Sie den Dienst um einen neuen Link"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”: the server uses an outdated way to connect, ask the service for a new link"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»: el servidor usa una forma de conexión obsoleta, pide al servicio un enlace nuevo"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»: سرور از روش اتصال قدیمی استفاده می‌کند، از سرویس لینک جدید بخواهید"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » : le serveur utilise un mode de connexion dépassé, demandez un nouveau lien au service"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»: сервер ескірген қосылу тәсілін қолданады, сервистен жаңа сілтеме сұраңыз"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”: o servidor usa uma forma de conexão antiga, peça ao serviço um link novo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»: сервер использует устаревший способ подключения, попросите у сервиса новую ссылку"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”: sunucu eski bir bağlantı yöntemi kullanıyor, hizmetten yeni bir bağlantı isteyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»: сервер використовує застарілий спосіб підключення, попросіть у сервісу нове посилання"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»: server eskirgan ulanish usulidan foydalanadi, xizmatdan yangi havola soʻrang"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”：服务器使用过时的连接方式，请向服务商索取新链接"
          }
        }
      }
    },
