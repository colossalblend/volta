    "routing_presets_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط للإضافة أو الإزالة. يمكنك تغيير الوجهة من داخل القاعدة نفسها."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əlavə etmək və ya silmək üçün toxunun. Hara yönləndirməyi qaydanın özündə dəyişmək olar."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Націсніце, каб дадаць або прыбраць. Куды накіроўваць, можна змяніць у самім правіле."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen zum Hinzufügen oder Entfernen. Wohin es geht, lässt sich in der Regel selbst ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to add or remove. You can change where it goes in the rule itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para añadir o quitar. Adónde se envía se puede cambiar en la propia regla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای افزودن یا برداشتن ضربه بزنید. مقصد را می‌توانید در خود قانون عوض کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez pour ajouter ou retirer. La destination se change dans la règle elle-même."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қосу не алып тастау үшін басыңыз. Қайда жіберетінін ереженің өзінде өзгертуге болады."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para adicionar ou remover. Para onde vai pode ser mudado na própria regra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы добавить или убрать. Куда направлять, можно поменять в самом правиле."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eklemek veya kaldırmak için dokunun. Nereye yönlendirileceğini kuralın kendisinde değiştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть, щоб додати або прибрати. Куди спрямовувати, можна змінити в самому правилі."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qoʻshish yoki olib tashlash uchun bosing. Qayerga yoʻnaltirishni qoidaning oʻzida oʻzgartirish mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按即可添加或移除。去向可在规则中修改。"
          }
        }
      }
    },
