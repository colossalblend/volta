    "split.ios.text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يسمح iPhone باختيار التطبيقات لـ VPN إلا على الأجهزة المُدارة. لكن يمكن تمرير مواقع البنوك والخدمات الحكومية وغيرها مباشرة: أضفها هنا وستمر خارج VPN."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone VPN üçün tətbiq seçməyə yalnız idarə olunan cihazlarda icazə verir. Amma bankların, dövlət xidmətlərinin və başqa xidmətlərin saytlarını birbaşa buraxmaq olar: onları bura əlavə edin, VPN-dən kənar keçəcəklər."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбіраць праграмы для VPN iPhone дазваляе толькі на кіраваных прыладах. Затое сайты банкаў, дзяржпаслуг і іншых сэрвісаў можна пусціць напрамую: дадайце іх сюды, і яны пойдуць міма VPN."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein iPhone erlaubt die App-Auswahl für das VPN nur auf verwalteten Geräten. Die Seiten von Banken, Behörden und anderen Diensten können aber direkt gehen: Fügen Sie sie hier hinzu, dann laufen sie am VPN vorbei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An iPhone allows choosing apps for the VPN only on managed devices. But the sites of banks, Gosuslugi and other services can go direct: add them here and they bypass the VPN."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El iPhone solo permite elegir apps para la VPN en dispositivos gestionados. Pero los sitios de bancos, trámites y otros servicios pueden ir directos: añádelos aquí y no pasarán por la VPN."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone انتخاب برنامه‌ها برای VPN را فقط در دستگاه‌های مدیریت‌شده اجازه می‌دهد. اما سایت بانک‌ها، خدمات دولتی و سرویس‌های دیگر را می‌شود مستقیم فرستاد: آن‌ها را اینجا اضافه کنید تا بیرون از VPN بروند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’iPhone ne permet de choisir les apps du VPN que sur les appareils gérés. Mais les sites des banques, des services publics et d’autres services peuvent passer en direct : ajoutez-les ici et ils contourneront le VPN."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone VPN үшін қолданбаларды тек басқарылатын құрылғыларда таңдауға рұқсат етеді. Есесіне банктер, мемлекеттік қызметтер және басқа сервистер сайттарын тікелей жіберуге болады: оларды осында қосыңыз, олар VPN-сіз өтеді."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iPhone só deixa escolher apps para a VPN em aparelhos gerenciados. Mas os sites de bancos, serviços públicos e outros podem ir direto: adicione-os aqui e eles passam fora da VPN."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбирать приложения для VPN iPhone разрешает только на управляемых устройствах. Зато сайты банков, Госуслуг и других сервисов можно пустить напрямую: добавьте их сюда, и они пойдут мимо VPN."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone, VPN için uygulama seçmeye yalnızca yönetilen cihazlarda izin verir. Ama bankaların, devlet hizmetlerinin ve diğer servislerin sitelerini doğrudan gönderebilirsiniz: buraya ekleyin, VPN dışından gitsinler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибирати застосунки для VPN iPhone дозволяє лише на керованих пристроях. Зате сайти банків, держпослуг та інших сервісів можна пустити напряму: додайте їх сюди, і вони підуть повз VPN."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone VPN uchun ilovalarni faqat boshqariladigan qurilmalarda tanlashga ruxsat beradi. Lekin banklar, davlat xizmatlari va boshqa servislar saytlarini toʻgʻridan-toʻgʻri yuborish mumkin: ularni shu yerga qoʻshing, ular VPN’dan tashqarida oʻtadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 只允许在受管理设备上为 VPN 选择应用。但银行、政务等服务的网站可以直连：把它们添加到这里，就会绕过 VPN。"
          }
        }
      }
    },
