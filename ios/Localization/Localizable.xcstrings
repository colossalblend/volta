          "stringUnit": {
            "state": "translated",
            "value": "Cette règle vient de l’abonnement. Vous pouvez la désactiver, et les changements resteront jusqu’à la prochaine mise à jour."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл ережені жазылым жіберген. Оны өшіруге болады, ал өзгерістер келесі жаңартуға дейін сақталады."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta regra veio da assinatura. Você pode desativá-la, e as mudanças ficam até a próxima atualização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правило прислала подписка. Его можно выключить, а изменения сохранятся до следующего обновления."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kural abonelikle geldi. Kapatabilirsiniz; değişiklikleriniz bir sonraki güncellemeye kadar kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Правило надіслала підписка. Його можна вимкнути, а зміни збережуться до наступного оновлення."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu qoidani obuna yuborgan. Uni oʻchirish mumkin, oʻzgarishlar esa keyingi yangilanishgacha saqlanadi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此规则来自订阅。可以关闭它，修改会保留到下次更新。"
          }
        }
      }
    },
