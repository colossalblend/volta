    "routing_adblock_standard_desc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحظر الإعلانات والتحليلات وأدوات تتبّع الأعطال والجلسات في كل التطبيقات. تبقى أزرار تسجيل الدخول والفيديو والروابط في الرسائل ومحادثات الدعم تعمل."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütün tətbiqlərdə reklamı, analitikanı, xəta və sessiya izləyicilərini bloklayır. Giriş düymələri, video, məktublardakı keçidlər və dəstək çatları əvvəlki kimi işləyir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Блакуе рэкламу, аналітыку і трэкеры памылак і сесій ва ўсіх праграмах. Кнопкі ўваходу, відэа, спасылкі ў лістах і чаты падтрымкі працуюць як раней."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperrt Werbung, Analyse sowie Fehler- und Sitzungstracker in allen Apps. Anmeldeknöpfe, Videos, Links in E-Mails und Support-Chats funktionieren weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocks ads, analytics and crash and session trackers in every app. Sign-in buttons, video, links in emails and support chats keep working."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea anuncios, analítica y rastreadores de errores y sesiones en todas las apps. Los botones de inicio de sesión, los vídeos, los enlaces de los correos y los chats de soporte siguen funcionando."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تبلیغات، تحلیل‌گرها و ردیاب‌های خطا و نشست را در همهٔ برنامه‌ها مسدود می‌کند. دکمه‌های ورود، ویدیو، پیوندهای داخل ایمیل و گفت‌وگوهای پشتیبانی کار می‌کنند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloque les pubs, l’analytique et les traqueurs d’erreurs et de sessions dans toutes les applis. Les boutons de connexion, les vidéos, les liens des e-mails et les chats d’assistance continuent de marcher."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Барлық қолданбадағы жарнаманы, аналитиканы, қате мен сеанс трекерлерін бұғаттайды. Кіру батырмалары, бейне, хаттардағы сілтемелер мен қолдау чаттары бұрынғыдай жұмыс істейді."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueia anúncios, análises e rastreadores de erros e sessões em todos os apps. Botões de login, vídeos, links em e-mails e chats de suporte continuam funcionando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокирует рекламу, аналитику и трекеры ошибок и сессий во всех приложениях. Кнопки входа, видео, ссылки в письмах и чаты поддержки продолжают работать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm uygulamalarda reklamları, analitiği, hata ve oturum izleyicilerini engeller. Giriş düğmeleri, videolar, e-postalardaki bağlantılar ve destek sohbetleri çalışmaya devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокує рекламу, аналітику й трекери помилок і сесій в усіх застосунках. Кнопки входу, відео, посилання в листах і чати підтримки працюють як і раніше."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Barcha ilovalarda reklama, analitika hamda xato va seans trekerlarini bloklaydi. Kirish tugmalari, video, xatlardagi havolalar va qoʻllab-quvvatlash chatlari avvalgidek ishlaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在所有应用中拦截广告、统计分析以及错误和会话跟踪器。登录按钮、视频、邮件中的链接和客服聊天照常可用。"
          }
        }
      }
    },
