          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Many servers ban users for seeding, and going direct, your internet provider sees it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muchos servidores banean por compartir torrents, y en directo los ve tu proveedor de internet"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بسیاری از سرورها به‌خاطر اشتراک‌گذاری تورنت مسدود می‌کنند و در حالت مستقیم، ارائه‌دهندهٔ اینترنت آن را می‌بیند"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaucoup de serveurs bannissent pour le partage, et en direct votre fournisseur d’accès les voit"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Көп сервер тарату үшін бұғаттайды, ал тікелей қосылса, оларды провайдер көреді"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitos servidores banem por compartilhar torrents, e no direto sua operadora vê"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Многие серверы банят за раздачи, а напрямую их видит провайдер"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birçok sunucu paylaşım yüzünden yasaklıyor, doğrudan bağlanınca da internet sağlayıcınız görüyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Багато серверів банять за роздачі, а напряму їх бачить провайдер"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Koʻp serverlar tarqatish uchun bloklaydi, toʻgʻridan-toʻgʻri esa ularni provayder koʻradi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "许多服务器会因做种而封禁，直连时运营商也能看到"
          }
        }
      }
    },
