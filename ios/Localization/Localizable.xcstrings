    "settings_backup_warning": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي الملف على اشتراكاتك: احتفظ به لنفسك ولا ترسله للغرباء."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Faylda abunələriniz var: onu özünüzdə saxlayın və yad adamlara göndərməyin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У файле вашы падпіскі: захоўвайце яго ў сябе і не перасылайце старонім."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei enthält Ihre Abos: Bewahren Sie sie gut auf und geben Sie sie nicht an Fremde weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file contains your subscriptions: keep it to yourself and don't send it to strangers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo contiene tus suscripciones: guárdalo para ti y no se lo envíes a nadie."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اشتراک‌های شما در این فایل است: آن را پیش خودتان نگه دارید و برای دیگران نفرستید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier contient vos abonnements : gardez-le pour vous et ne l'envoyez pas à des inconnus."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлда сіздің жазылымдарыңыз бар: оны өзіңізде сақтаңыз және бөгде адамдарға жібермеңіз."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo contém suas assinaturas: guarde-o com você e não o envie a estranhos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В файле ваши подписки: храните его у себя и не пересылайте посторонним."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyada abonelikleriniz var: kendinizde saklayın, başkalarına göndermeyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У файлі ваші підписки: зберігайте його в себе й не пересилайте стороннім."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faylda obunalaringiz bor: uni oʻzingizda saqlang va begonalarga yubormang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件中包含你的订阅：请自己保管，不要发给他人。"
          }
        }
      }
    },
    "settings_follow_network_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند التبديل بين Wi-Fi وبيانات الجوال، يُفحص الخادم ويُغيَّر تلقائيًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi ilə mobil internet arasında keçid edəndə server özü yoxlanılır və dəyişdirilir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пры пераходзе паміж Wi-Fi і мабільным інтэрнэтам сервер правяраецца і мяняецца сам."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Wechsel zwischen WLAN und mobilen Daten wird der Server automatisch geprüft und gewechselt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you switch between Wi-Fi and mobile data, the server is checked and changed automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al pasar de Wi-Fi a datos móviles o al revés, el servidor se comprueba y se cambia solo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنگام جابه‌جایی بین Wi-Fi و اینترنت همراه، سرور خودکار بررسی و عوض می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous passez du Wi-Fi aux données mobiles, le serveur est vérifié et changé automatiquement."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi мен мобильді интернет арасында ауысқанда сервер өзі тексеріліп, ауыстырылады."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao alternar entre Wi-Fi e dados móveis, o servidor é verificado e trocado sozinho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При переходе между Wi-Fi и мобильным интернетом сервер проверяется и меняется сам."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi ile mobil veri arasında geçiş yapınca sunucu kendiliğinden denetlenir ve değiştirilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час переходу між Wi-Fi і мобільним інтернетом сервер перевіряється й змінюється сам."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi va mobil internet oʻrtasida oʻtganda server oʻzi tekshiriladi va almashtiriladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Wi-Fi 和移动数据之间切换时，会自动检查并更换服务器。"
          }
        }
      }
    },
