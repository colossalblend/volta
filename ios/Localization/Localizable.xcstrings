    "vpn.error.permission": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يسمح iOS لـ Volta بإنشاء VPN. اسمح بإضافة إعداد VPN عندما يطلب iPhone ذلك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS Volta-ya VPN yaratmağa icazə vermədi. iPhone soruşanda VPN konfiqurasiyasını əlavə etməyə icazə verin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS не дазволіла Volta стварыць VPN. Дазвольце дадаць канфігурацыю VPN, калі iPhone спытае."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS hat das VPN nicht erlaubt. Erlaube das Hinzufügen der VPN-Konfiguration, wenn das iPhone fragt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS didn't let Volta create the VPN. Allow adding the VPN configuration when the iPhone asks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS no permitió crear la VPN. Permite añadir la configuración VPN cuando el iPhone lo pida."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS اجازه ساخت VPN را نداد. وقتی iPhone پرسید، اجازه افزودن پیکربندی VPN را بدهید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS n’a pas autorisé Volta à créer le VPN. Autorisez l’ajout de la configuration VPN quand l’iPhone le demande."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS VPN жасауға рұқсат бермеді. iPhone сұрағанда VPN конфигурациясын қосуға рұқсат етіңіз."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS não deixou o Volta criar a VPN. Permita adicionar a configuração de VPN quando o iPhone pedir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS не дала создать VPN. Разрешите добавить конфигурацию VPN, когда iPhone спросит."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS VPN oluşturmaya izin vermedi. iPhone sorduğunda VPN yapılandırmasının eklenmesine izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS не дала створити VPN. Дозвольте додати конфігурацію VPN, коли iPhone запитає."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS VPN yaratishga ruxsat bermadi. iPhone so‘raganda VPN konfiguratsiyasini qo‘shishga ruxsat bering."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 未允许创建 VPN。当 iPhone 询问时，请允许添加 VPN 配置。"
          }
        }
      }
    },
    "vpn.error.stale": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف VPN قديم، حاول مجددًا"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN profili köhnəlib, yenidən cəhd edin"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Профіль VPN састарэў, паспрабуйце яшчэ раз"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das VPN-Profil ist veraltet, versuche es noch einmal"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The VPN profile is outdated, try again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil VPN está desactualizado, inténtalo otra vez"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نمایه VPN قدیمی است، دوباره امتحان کنید"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil VPN est périmé, réessayez"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN профилі ескірген, қайта көріңіз"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O perfil da VPN está desatualizado, tente de novo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Профиль VPN устарел, попробуйте ещё раз"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN profili eski, tekrar deneyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Профіль VPN застарів, спробуйте ще раз"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN profili eskirgan, qayta urinib ko‘ring"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN 配置已过时，请再试一次"
          }
        }
      }
    }
  },
  "version": "1.0"
}
