    "sub.error.noServers": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعثر على أي خادم في الاشتراك. تحقّق من الرابط أو راسل دعم خدمة VPN."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Abunəlikdə heç bir server tapılmadı. Keçidi yoxlayın və ya VPN xidmətinin dəstək komandasına yazın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У падпісцы не знайшлося ніводнага сервера. Праверце спасылку або напішыце ў падтрымку VPN-сэрвісу."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Abo wurde kein einziger Server gefunden. Prüfen Sie den Link oder schreiben Sie dem Support Ihres VPN-Dienstes."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No servers were found in the subscription. Check the link or write to your VPN service's support."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ningún servidor en la suscripción. Revisa el enlace o escribe al soporte de tu servicio VPN."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ سروری در اشتراک پیدا نشد. پیوند را بررسی کنید یا به پشتیبانی سرویس VPN پیام دهید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun serveur n’a été trouvé dans l’abonnement. Vérifiez le lien ou écrivez au support de votre service VPN."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазылымнан бірде-бір сервер табылмады. Сілтемені тексеріңіз немесе VPN қызметінің қолдау қызметіне жазыңыз."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum servidor foi encontrado na assinatura. Verifique o link ou escreva para o suporte do seu serviço de VPN."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В подписке не нашлось ни одного сервера. Проверьте ссылку или напишите в поддержку VPN-сервиса."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonelikte hiç sunucu bulunamadı. Bağlantıyı kontrol edin veya VPN hizmetinin desteğine yazın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У підписці не знайшлося жодного сервера. Перевірте посилання або напишіть у підтримку VPN-сервісу."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Obunada birorta ham server topilmadi. Havolani tekshiring yoki VPN xizmatining qoʻllab-quvvatlash xizmatiga yozing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅中没有找到任何服务器。请检查链接，或联系 VPN 服务的客服。"
          }
