    "routing_subscriptions_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي ملف تعريف يستخدمه كل اشتراك. «%1$@» تعني الملف المحدد في الأعلى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər abunəliyin hansı profildən istifadə etdiyi. «%1$@» yuxarıda seçilmiş profil deməkdir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Які профіль выкарыстоўвае кожная падпіска. «%1$@» азначае выбраны вышэй."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welches Profil jedes Abo nutzt. „%1$@“ bedeutet das oben gewählte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which profile each subscription uses. “%1$@” means the one chosen above."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué perfil usa cada suscripción. «%1$@» significa el elegido arriba."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر اشتراک از کدام پروفایل استفاده می‌کند. «%1$@» یعنی همان که بالاتر انتخاب شده است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil utilisé par chaque abonnement. « %1$@ » désigne celui choisi plus haut."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр жазылым қай профильді қолданатыны. «%1$@» жоғарыда таңдалғанын білдіреді."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qual perfil cada assinatura usa. “%1$@” significa o escolhido acima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какой профиль использует каждая подписка. «%1$@» значит выбранный выше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her aboneliğin hangi profili kullandığı. “%1$@”, yukarıda seçilen profil demektir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Який профіль використовує кожна підписка. «%1$@» означає вибраний вище."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Har bir obuna qaysi profildan foydalanadi. «%1$@» yuqorida tanlangan profilni bildiradi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个订阅使用哪个方案。“%1$@”即上方选中的方案。"
          }
        }
      }
    },
