    "network_weak_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "‏2G أو لا توجد إشارة: قد لا تعمل VPN. يساعد Wi-Fi أو مكان بإشارة أفضل."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "2G və ya siqnal yoxdur: VPN işləməyə bilər. Wi-Fi və ya rabitəsi daha yaxşı yer kömək edər."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "2G або няма сігналу: VPN можа не працаваць. Дапаможа Wi-Fi або месца, дзе сувязь лепшая."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2G oder kein Empfang: Das VPN funktioniert vielleicht nicht. WLAN oder ein Ort mit besserem Empfang hilft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2G or no signal: the VPN may not work. Wi-Fi or a better signal will help."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "2G o sin señal: puede que la VPN no funcione. Ayudará una red Wi-Fi o un lugar con mejor cobertura."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "2G یا بدون آنتن: ممکن است VPN کار نکند. Wi-Fi یا جایی با آنتن بهتر کمک می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "2G ou aucun signal : le VPN risque de ne pas fonctionner. Le Wi-Fi ou un endroit mieux couvert aidera."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "2G немесе сигнал жоқ: VPN жұмыс істемеуі мүмкін. Wi-Fi немесе байланысы жақсы жер көмектеседі."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "2G ou sem sinal: a VPN pode não funcionar. Uma rede Wi-Fi ou um lugar com sinal melhor ajuda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "2G или нет сигнала: VPN может не работать. Поможет Wi-Fi или место, где связь лучше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "2G veya sinyal yok: VPN çalışmayabilir. Wi-Fi veya daha iyi çeken bir yer yardımcı olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "2G або немає сигналу: VPN може не працювати. Допоможе Wi-Fi або місце з кращим зв’язком."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "2G yoki signal yoʻq: VPN ishlamasligi mumkin. Wi-Fi yoki aloqa yaxshiroq joy yordam beradi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2G 或没有信号：VPN 可能无法使用。换用 Wi-Fi 或到信号更好的地方会有帮助。"
          }
        }
      }
    },
