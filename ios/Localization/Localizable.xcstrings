    "routing_from_subscriptions_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل لاشتراكها فقط. لتستخدم هذه القواعد بنفسك، أنشئ نسخة منها."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız öz abunəliyi üçün işləyir. Bu qaydaları özünüzə götürmək üçün surətini çıxarın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Працуюць толькі для сваёй падпіскі. Каб узяць такія правілы сабе, зрабіце копію."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelten nur für ihr eigenes Abo. Um diese Regeln selbst zu nutzen, erstellen Sie eine Kopie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These work only for their own subscription. To use these rules yourself, make a copy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo funcionan para su propia suscripción. Para usar estas reglas tú mismo, haz una copia."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط برای اشتراک خودشان کار می‌کنند. برای استفادهٔ خودتان از این قوانین، یک نسخه از آن‌ها بسازید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne fonctionnent que pour leur propre abonnement. Pour utiliser ces règles vous-même, faites-en une copie."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тек өз жазылымы үшін жұмыс істейді. Бұл ережелерді өзіңізге алу үшін көшірмесін жасаңыз."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Funcionam só para a própria assinatura. Para usar essas regras você mesmo, faça uma cópia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работают только для своей подписки. Чтобы взять такие правила себе, сделайте копию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca kendi aboneliği için çalışır. Bu kuralları kendiniz kullanmak için bir kopyasını oluşturun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Працюють лише для своєї підписки. Щоб узяти такі правила собі, зробіть копію."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faqat oʻz obunasi uchun ishlaydi. Bu qoidalarni oʻzingizga olish uchun nusxasini yarating."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅对所属订阅生效。如需自己使用这些规则，请创建副本。"
          }
        }
      }
    },
