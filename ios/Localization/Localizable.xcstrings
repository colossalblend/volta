        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти правила принадлежат другой подписке и не могут быть применены здесь"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kurallar başka bir aboneliğe ait ve burada uygulanamaz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці правила належать іншій підписці й не можуть бути застосовані тут"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu qoidalar boshqa obunaga tegishli va bu yerda qoʻllanmaydi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些规则属于另一个订阅，不能在这里使用"
