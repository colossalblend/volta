    "routing_profiles_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدد ملف التعريف أي المواقع تمر عبر VPN، وأيها يتصل مباشرة، وأيها يُحظر."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil hansı saytların VPN ilə, hansıların birbaşa açılacağını, hansıların isə bloklanacağını müəyyən edir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Профіль вырашае, якія сайты ідуць праз VPN, якія напрамую, а якія блакуюцца."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Profil legt fest, welche Websites über das VPN laufen, welche direkt und welche gesperrt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A profile decides which sites go through the VPN, which go direct and which are blocked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil decide qué sitios van por la VPN, cuáles van directos y cuáles se bloquean."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پروفایل تعیین می‌کند کدام سایت‌ها از طریق VPN بروند، کدام مستقیم و کدام مسدود شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil décide quels sites passent par le VPN, lesquels vont en direct et lesquels sont bloqués."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Профиль қай сайттар VPN арқылы, қайсысы тікелей өтетінін және қайсысы бұғатталатынын шешеді."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O perfil decide quais sites passam pela VPN, quais vão direto e quais são bloqueados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Профиль решает, какие сайты идут через VPN, какие напрямую, а какие блокируются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil, hangi sitelerin VPN üzerinden, hangilerinin doğrudan gideceğine ve hangilerinin engelleneceğine karar verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Профіль вирішує, які сайти йдуть через VPN, які напряму, а які блокуються."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil qaysi saytlar VPN orqali, qaysilari toʻgʻridan-toʻgʻri ochilishini va qaysilari bloklanishini belgilaydi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方案决定哪些网站走 VPN、哪些直连、哪些被屏蔽。"
          }
        }
      }
    },
