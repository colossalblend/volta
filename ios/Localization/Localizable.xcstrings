      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صفحة Volta في الإعدادات: اللغة والإشعارات والأذونات"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlarda Volta səhifəsi: dil, bildirişlər və icazələr"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Старонка Volta ў наладах: мова, апавяшчэнні і дазволы"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltas Seite in den Einstellungen: Sprache, Mitteilungen und Berechtigungen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta's page in Settings: language, notifications and permissions"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La página de Volta en Ajustes: idioma, avisos y permisos"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "صفحه Volta در تنظیمات: زبان، اعلان‌ها و مجوزها"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La page de Volta dans Réglages : langue, notifications et autorisations"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Баптаулардағы Volta беті: тіл, хабарландырулар мен рұқсаттар"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A página do Volta nos Ajustes: idioma, notificações e permissões"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страница Volta в Настройках: язык, уведомления и разрешения"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar’daki Volta sayfası: dil, bildirimler ve izinler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сторінка Volta в Налаштуваннях: мова, сповіщення і дозволи"
