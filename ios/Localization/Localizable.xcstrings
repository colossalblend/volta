    "import.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشتراك أو خادم أو مفتاح. الصقه كما هو، وسيتعرّف عليه Volta بنفسه."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Abunə, server və ya açar. Olduğu kimi yapışdırın, Volta özü anlayacaq."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Падпіску, сервер або ключ. Устаўце як ёсць, Volta разбярэцца сама."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Abo, ein Server oder ein Schlüssel. Einfach so einfügen, wie es ist – Volta erkennt es selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A subscription, server or key. Paste it as it is, Volta will figure it out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una suscripción, un servidor o una clave. Pégalo tal cual y Volta se encarga."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اشتراک، سرور یا کلید. همان‌طور که هست بچسبانید، Volta خودش می‌فهمد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un abonnement, un serveur ou une clé. Collez-le tel quel, Volta s'en charge."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жазылым, сервер немесе кілт. Қалай болса солай қойыңыз, Volta өзі анықтайды."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma assinatura, um servidor ou uma chave. Cole do jeito que está, o Volta entende sozinho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписку, сервер или ключ. Вставьте как есть, Volta разберётся сама."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonelik, sunucu ya da anahtar. Olduğu gibi yapıştırın, Volta kendisi anlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підписку, сервер або ключ. Вставте як є, Volta розбереться сама."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Obuna, server yoki kalit. Qanday boʻlsa shunday qoʻying, Volta oʻzi tushunib oladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅、服务器或密钥。原样粘贴即可，Volta 会自动识别。"
          }
        }
      }
    },
