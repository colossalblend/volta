    "server.error.encryption": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»: يستخدم الخادم تشفيرًا لا يدعمه Volta"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»: server Volta-nın dəstəkləmədiyi şifrələmədən istifadə edir"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»: сервер выкарыстоўвае шыфраванне, якое Volta не падтрымлівае"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“: Der Server nutzt eine Verschlüsselung, die Volta nicht unterstützt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”: the server uses encryption that Volta doesn't support"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»: el servidor usa un cifrado que Volta no admite"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»: سرور از رمزگذاری‌ای استفاده می‌کند که Volta پشتیبانی نمی‌کند"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » : le serveur utilise un chiffrement que Volta ne prend pas en charge"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»: сервер Volta қолдамайтын шифрлауды қолданады"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”: o servidor usa uma criptografia que o Volta não suporta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»: сервер использует шифрование, которое Volta не поддерживает"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”: sunucu, Volta'nın desteklemediği bir şifreleme kullanıyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»: сервер використовує шифрування, яке Volta не підтримує"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@»: server Volta qoʻllab-quvvatlamaydigan shifrlashdan foydalanadi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”：服务器使用了 Volta 不支持的加密方式"
          }
        }
      }
    },
    "server.error.helperOnly": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ لا يعمل على iPhone: في Android يشغّله برنامج مساعد منفصل، ويمنح iOS ملحق VPN نحو 50 ميغابايت ومكانًا لنواة Xray فقط."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ iPhone-da işləmir: Android-də onu ayrıca köməkçi proqram idarə edir, iOS isə VPN genişlənməsinə təxminən 50 MB və yalnız Xray nüvəsi üçün yer verir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не працуе на iPhone: на Android яго вядзе асобная праграма-памочнік, а VPN-пашырэнню iOS дае каля 50 МБ памяці і месца толькі для ядра Xray."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ funktioniert auf dem iPhone nicht: Unter Android läuft es in einem eigenen Hilfsprogramm, und iOS gibt der VPN-Erweiterung etwa 50 MB und nur Platz für den Xray-Kern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ doesn't work on an iPhone: on Android a separate helper program runs it, and iOS gives the VPN extension about 50 MB and room for the Xray core only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no funciona en iPhone: en Android lo ejecuta un programa auxiliar aparte, y iOS da a la extensión VPN unos 50 MB y sitio solo para el núcleo Xray."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ روی iPhone کار نمی‌کند: در Android برنامهٔ کمکی جداگانه‌ای آن را اجرا می‌کند و iOS به افزونهٔ VPN حدود ۵۰ مگابایت و جا فقط برای هستهٔ Xray می‌دهد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne fonctionne pas sur iPhone : sous Android, un programme d’aide séparé le fait tourner, et iOS ne donne à l’extension VPN qu’environ 50 Mo et de la place pour le seul cœur Xray."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ iPhone-да жұмыс істемейді: Android-та оны бөлек көмекші бағдарлама жүргізеді, ал iOS VPN кеңейтіміне шамамен 50 МБ және тек Xray ядросына орын береді."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não funciona no iPhone: no Android um programa auxiliar separado o executa, e o iOS dá à extensão de VPN cerca de 50 MB e espaço só para o núcleo Xray."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не работает на iPhone: на Android его ведёт отдельная программа-помощник, а VPN-расширению iOS даёт около 50 МБ памяти и место только для ядра Xray."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ iPhone’da çalışmaz: Android’de onu ayrı bir yardımcı program yürütür, iOS ise VPN uzantısına yaklaşık 50 MB ve yalnızca Xray çekirdeğine yer verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не працює на iPhone: на Android його веде окрема програма-помічник, а VPN-розширенню iOS дає близько 50 МБ пам’яті й місце лише для ядра Xray."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ iPhone’da ishlamaydi: Android’da uni alohida yordamchi dastur yuritadi, iOS esa VPN kengaytmasiga taxminan 50 MB va faqat Xray yadrosi uchun joy beradi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 无法在 iPhone 上使用：在 Android 上由单独的辅助程序运行，而 iOS 只给 VPN 扩展约 50 MB 内存，只够放 Xray 内核。"
          }
        }
      }
    },
