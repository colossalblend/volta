    "settings.engine.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا اشتغل VPN ولم تُفتح المواقع، جرّب الطريقة الأخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN qoşulur, amma saytlar açılmırsa, digər üsulu sınayın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Калі VPN уключаецца, але сайты не адкрываюцца, паспрабуйце іншы спосаб."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn das VPN angeht, aber Seiten nicht laden, probiere den anderen Weg."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the VPN turns on but sites don't open, try the other way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la VPN se activa pero los sitios no abren, prueba la otra forma."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر VPN روشن می‌شود ولی سایت‌ها باز نمی‌شوند، روش دیگر را امتحان کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le VPN s’active mais que les sites ne s’ouvrent pas, essayez l’autre méthode."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN қосылып, бірақ сайттар ашылмаса, басқа тәсілді көріңіз."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a VPN liga mas os sites não abrem, tente o outro modo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если VPN включается, но сайты не открываются, попробуйте другой способ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN açılıyor ama siteler açılmıyorsa diğer yolu deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо VPN вмикається, але сайти не відкриваються, спробуйте інший спосіб."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN yoqilsa-yu, saytlar ochilmasa, boshqa usulni sinab ko‘ring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 VPN 能开启但网站打不开，请换另一种方式。"
          }
        }
      }
    },
