    "detect.control.text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُضاف، بل يشغّل VPN أو يوقفه"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əlavə olunmur, VPN-i qoşur və ya söndürür"
