    "settings.dns": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح المواقع عبر VPN"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Saytları VPN ilə aç"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адкрываць сайты праз VPN"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Websites über VPN öffnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open websites through VPN"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir sitios a través de la VPN"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "باز کردن سایت‌ها از طریق VPN"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir les sites via le VPN"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сайттарды VPN арқылы ашу"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir sites pela VPN"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывать сайты через VPN"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siteleri VPN üzerinden aç"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкривати сайти через VPN"
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Saytlarni VPN orqali ochish"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 VPN 打开网站"
          }
        }
      }
    },
    "settings.dns.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُعرف عناوين المواقع أيضًا عبر VPN، فيقلّ الحجب."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayt ünvanları da VPN ilə müəyyən edilir, belə bloklanma az olur."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адрасы сайтаў таксама вызначаюцца праз VPN, так менш блакіровак."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch die Adressen von Websites werden über das VPN aufgelöst, so gibt es weniger Sperren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Website addresses are looked up through VPN too, so there are fewer blocks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las direcciones de los sitios también se resuelven a través de la VPN; así hay menos bloqueos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نشانی سایت‌ها هم از طریق VPN پیدا می‌شود و مسدودسازی کمتر است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les adresses des sites sont aussi résolues via le VPN : moins de blocages."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сайт мекенжайлары да VPN арқылы анықталады, осылайша бұғаттау азаяды."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os endereços dos sites também são resolvidos pela VPN, assim há menos bloqueios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адреса сайтов тоже узнаются через VPN, так меньше блокировок."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Site adresleri de VPN üzerinden çözülür, böylece engellemeler azalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Адреси сайтів теж визначаються через VPN, так менше блокувань."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayt manzillari ham VPN orqali aniqlanadi, shunda bloklashlar kamroq boʻladi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网站地址也通过 VPN 解析，这样被屏蔽的情况更少。"
          }
        }
      }
    },
