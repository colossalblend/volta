    "geo.error.tooBig": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القائمة %@ كبيرة جدًا على iPhone: يمنح iOS ملحق VPN نحو 50 ميغابايت من الذاكرة. احذفها من القواعد أو استبدلها بمواقع وعناوين."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ siyahısı iPhone üçün çox böyükdür: iOS VPN genişlənməsinə təxminən 50 MB yaddaş verir. Onu qaydalardan çıxarın və ya sayt və ünvanlarla əvəz edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Спіс %@ занадта вялікі для iPhone: iOS дае VPN-пашырэнню каля 50 МБ памяці. Прыберыце яго з правіл або замяніце сайтамі і адрасамі."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Liste %@ ist zu groß für ein iPhone: iOS gibt der VPN-Erweiterung etwa 50 MB Speicher. Entfernen Sie sie aus den Regeln oder nehmen Sie Seiten und Adressen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The list %@ is too big for an iPhone: iOS gives the VPN extension about 50 MB of memory. Remove it from the rules or use sites and addresses instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista %@ es demasiado grande para un iPhone: iOS da a la extensión VPN unos 50 MB de memoria. Quítala de las reglas o usa sitios y direcciones."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فهرست %@ برای iPhone خیلی بزرگ است: iOS به افزونهٔ VPN حدود ۵۰ مگابایت حافظه می‌دهد. آن را از قوانین بردارید یا به‌جایش سایت و نشانی بگذارید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste %@ est trop grande pour un iPhone : iOS donne environ 50 Mo de mémoire à l’extension VPN. Retirez-la des règles ou utilisez des sites et des adresses."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ тізімі iPhone үшін тым үлкен: iOS VPN кеңейтіміне шамамен 50 МБ жад береді. Оны ережелерден алып тастаңыз немесе сайттар мен мекенжайлармен ауыстырыңыз."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista %@ é grande demais para o iPhone: o iOS dá à extensão de VPN cerca de 50 MB de memória. Tire-a das regras ou use sites e endereços."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список %@ слишком большой для iPhone: VPN-расширению iOS даёт около 50 МБ памяти. Уберите его из правил или замените на сайты и адреса."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ listesi iPhone için çok büyük: iOS, VPN uzantısına yaklaşık 50 MB bellek veriyor. Kurallardan çıkarın ya da yerine siteler ve adresler kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Список %@ завеликий для iPhone: iOS дає VPN-розширенню близько 50 МБ пам’яті. Приберіть його з правил або замініть сайтами й адресами."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ roʻyxati iPhone uchun juda katta: iOS VPN kengaytmasiga taxminan 50 MB xotira beradi. Uni qoidalardan olib tashlang yoki saytlar va manzillar bilan almashtiring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列表 %@ 对 iPhone 来说太大：iOS 只给 VPN 扩展约 50 MB 内存。请把它从规则中移除，或改用网站和地址。"
          }
        }
      }
    },
