    "settings.ping.real.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفحص السرعة الفعلية عبر الخادم. موصى به."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Server vasitəsilə real sürəti yoxlayır. Tövsiyə edirik."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Правярае сапраўдную хуткасць праз сервер. Рэкамендуем."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft die echte Geschwindigkeit über den Server. Empfohlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks the real speed through the server. Recommended."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba la velocidad real a través del servidor. Recomendado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرعت واقعی را از طریق سرور بررسی می‌کند. پیشنهاد ما همین است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie la vraie vitesse via le serveur. Recommandé."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер арқылы нақты жылдамдықты тексереді. Ұсынамыз."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica a velocidade real pelo servidor. Recomendado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверяет настоящую скорость через сервер. Рекомендуем."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu üzerinden gerçek hızı denetler. Önerilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевіряє справжню швидкість через сервер. Рекомендуємо."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Server orqali haqiqiy tezlikni tekshiradi. Tavsiya etamiz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过服务器检测真实速度。推荐。"
          }
        }
      }
    },
    "settings.ping.tcp.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسرع، لكنه قد يُظهر الخادم سليمًا وهو لا يعمل."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha sürətlidir, amma işləməyən serveri canlı göstərə bilər."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Хутчэй, але можа паказаць сервер жывым, калі ён не працуе."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schneller, kann aber einen Server als erreichbar zeigen, obwohl er nicht funktioniert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Faster, but may show a server as alive when it isn't working."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más rápido, pero puede mostrar un servidor como activo cuando no funciona."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سریع‌تر است، اما ممکن است سروری را که کار نمی‌کند سالم نشان دهد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus rapide, mais peut montrer un serveur comme actif alors qu'il ne fonctionne pas."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жылдамырақ, бірақ жұмыс істемейтін серверді жұмыс істеп тұр деп көрсетуі мүмкін."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais rápido, mas pode mostrar um servidor como ativo quando ele não funciona."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрее, но может показать сервер живым, когда он не работает."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha hızlı, ancak çalışmayan bir sunucuyu çalışıyor gibi gösterebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Швидше, але може показати сервер живим, коли він не працює."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tezroq, lekin ishlamayotgan serverni ham tirik deb koʻrsatishi mumkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更快，但可能把不能用的服务器显示为可用。"
          }
        }
      }
    },
